# No C original: laid out as ADSimDetector iocSimDetector/auto_settings.req,
# then the depth and pointcloud chains this IOC loads after commonPlugins.cmd.
file "d435i_settings.req",          P=$(P),  R=cam1:
file "NDArrayBase_settings.req",    P=$(P),  R=depth1:
file "NDStdArrays_settings.req",    P=$(P),  R=image1:
file "NDStdArrays_settings.req",    P=$(P),  R=image2:
file "NDStdArrays_settings.req",    P=$(P),  R=image3:
file "commonPlugin_settings.req",   P=$(P)
# commonPlugin_settings.req leaves Pva1 commented out, as C does; this IOC
# always serves it.
file "NDPva_settings.req",          P=$(P),  R=Pva1:
file "NDPva_settings.req",          P=$(P),  R=depthPva1:
file "NDROI_settings.req",          P=$(P),  R=depthROI1:
file "NDROIStat_settings.req",      P=$(P),  R=depthROIStat1:
file "NDStats_settings.req",        P=$(P),  R=depthStats1:
file "NDFileTIFF_settings.req",     P=$(P),  R=depthTIFF1:
file "NDFileHDF5_settings.req",     P=$(P),  R=depthHDF1:
file "NDFileHDF5_settings.req",     P=$(P),  R=pcHDF1:
