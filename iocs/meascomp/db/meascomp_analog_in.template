# C's measCompAnalogIn.template: the scan's average of the raw counts,
# converted over the driver's bounds; the default range is +-10 V.
record(ai, "$(P)$(R)") {
    field(DTYP, "asynInt32Average")
    field(INP,  "@asyn($(PORT),$(ADDR),1.0)ANALOG_IN_VALUE")
    field(LINR, "LINEAR")
    field(EGUF, "$(EGUF=10)")
    field(EGUL, "$(EGUL=-10)")
    field(HOPR, "$(HOPR=10)")
    field(LOPR, "$(LOPR=-10)")
    field(PREC, "6")
    field(SCAN, "$(SCAN=1 second)")
}

# The driver constructs the enum fields (readEnum).
record(mbbo, "$(P)$(R)Range") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1.0)ANALOG_IN_RANGE")
    field(PINI, "YES")
}

# The driver constructs the enum fields (readEnum).
record(mbbo, "$(P)$(R)Type") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1.0)ANALOG_IN_TYPE")
    field(PINI, "YES")
}

record(ao, "$(P)$(R)Rate") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1.0)ANALOG_IN_RATE")
    field(VAL,  "60")
    field(PINI, "YES")
}
