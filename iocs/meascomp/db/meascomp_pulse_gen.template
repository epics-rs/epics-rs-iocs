###################################################################
#  Frequency and pulse width, as alternatives to period/duty      #
#  cycle. Each pair keeps the other in step through a calcout.    #
###################################################################
record(calcout, "$(P)$(R)CalcFrequency") {
    field(INPA, "$(P)$(R)Period_RBV  CP MS")
    field(CALC, "A>0?1/A:0")
    field(OUT,  "$(P)$(R)Frequency.VAL  NPP MS")
}

record(ao, "$(P)$(R)Frequency") {
    field(FLNK, "$(P)$(R)CalcPeriod")
    field(PREC, "$(PREC=4)")
}

record(calcout, "$(P)$(R)CalcPeriod") {
    field(INPA, "$(P)$(R)Frequency.VAL  NPP MS")
    field(CALC, "A>0?1/A:0")
    field(OUT,  "$(P)$(R)Period.VAL  PP MS")
}

record(calc, "$(P)$(R)Frequency_RBV") {
    field(INPA, "$(P)$(R)Period_RBV  CP MS")
    field(CALC, "A>0?1/A:0")
    field(PREC, "$(PREC=4)")
}

record(calcout, "$(P)$(R)CalcWidth") {
    field(INPA, "$(P)$(R)Period_RBV  CP MS")
    field(INPB, "$(P)$(R)DutyCycle_RBV  NPP MS")
    field(CALC, "A*B")
    field(OUT,  "$(P)$(R)Width.VAL  NPP MS")
}

record(ao, "$(P)$(R)Width") {
    field(FLNK, "$(P)$(R)CalcDutyCycle")
    field(PREC, "$(PREC=4)")
}

record(calcout, "$(P)$(R)CalcDutyCycle") {
    field(INPA, "$(P)$(R)Width.VAL  NPP MS")
    field(INPB, "$(P)$(R)Period_RBV  NPP MS")
    field(CALC, "B>0?A/B:0")
    field(OUT,  "$(P)$(R)DutyCycle.VAL  PP MS")
}

record(calc, "$(P)$(R)Width_RBV") {
    field(INPA, "$(P)$(R)Period_RBV  CP MS")
    field(INPB, "$(P)$(R)DutyCycle_RBV  NPP MS")
    field(CALC, "A*B")
    field(PREC, "$(PREC=4)")
}
