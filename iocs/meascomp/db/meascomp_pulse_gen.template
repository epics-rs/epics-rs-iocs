record(ai, "$(P)$(R)Delay_RBV") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),1.0)PULSE_DELAY")
    field(PREC, "6")
    field(SCAN, "I/O Intr")
