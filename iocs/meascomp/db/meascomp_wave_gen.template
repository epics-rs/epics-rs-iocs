# Waveform generator control records
# Macros: P (prefix), PORT (asyn port)

# busy + asyn:READBACK so the record follows the driver: a one-shot scan
# stops by itself and a client waiting on Run must see it clear.
record(busy, "$(P)WaveGenRun") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)WAVEGEN_RUN")
    field(ZNAM, "Stop")
    field(ONAM, "Run")
    info(asyn:READBACK, "1")
}

# Readback of the frequency in use; set it through UserFrequency or
# IntFrequency below, whichever matches the selected wave type.
record(ai, "$(P)WaveGenFreq") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1.0)WAVEGEN_FREQ")
    field(PREC, "3")
    field(SCAN, "I/O Intr")
}

record(ai, "$(P)WaveGenDwellActual") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1.0)WAVEGEN_DWELL_ACTUAL")
    field(PREC, "6")
    field(SCAN, "I/O Intr")
}

record(ai, "$(P)WaveGenTotalTime") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1.0)WAVEGEN_TOTAL_TIME")
    field(PREC, "3")
    field(SCAN, "I/O Intr")
}

record(longin, "$(P)WaveGenNumPoints") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,1.0)WAVEGEN_NUM_POINTS")
    field(SCAN, "I/O Intr")
}

###################################################################
# A user-defined waveform is played back at its own point count    #
# and dwell; an internally generated one at its own. The driver    #
# rejects a mixture across enabled channels, because the two take  #
# their timing from different parameters.                          #
###################################################################
record(longout, "$(P)WaveGenUserNumPoints") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)WAVEGEN_USER_NUM_POINTS")
    field(VAL,  "$(WGEN_POINTS=2048)")
    field(DRVL, "1")
    field(DRVH, "$(WGEN_POINTS=2048)")
    field(PINI, "YES")
}

record(longout, "$(P)WaveGenIntNumPoints") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)WAVEGEN_INT_NUM_POINTS")
    field(VAL,  "$(WGEN_POINTS=2048)")
    field(DRVL, "1")
    field(DRVH, "$(WGEN_POINTS=2048)")
    field(PINI, "YES")
}

record(ao, "$(P)WaveGenUserDwell") {
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0,1.0)WAVEGEN_USER_DWELL")
    field(PREC, "6")
    field(VAL,  "0.001")
    field(PINI, "YES")
    field(FLNK, "$(P)WaveGenCalcUserFrequency")
}

record(calcout, "$(P)WaveGenCalcUserFrequency") {
    field(INPA, "$(P)WaveGenUserDwell  NPP MS")
    field(INPB, "$(P)WaveGenUserNumPoints  NPP MS")
    field(CALC, "(A>0&&B>0)?1/(A*B):0")
    field(OUT,  "$(P)WaveGenUserFrequency.VAL  NPP MS")
}

record(ao, "$(P)WaveGenUserFrequency") {
    field(PREC, "3")
    field(FLNK, "$(P)WaveGenCalcUserDwell")
}

record(calcout, "$(P)WaveGenCalcUserDwell") {
    field(INPA, "$(P)WaveGenUserFrequency  NPP MS")
    field(INPB, "$(P)WaveGenUserNumPoints  NPP MS")
    field(CALC, "(A>0&&B>0)?1/(A*B):0")
    field(OUT,  "$(P)WaveGenUserDwell.VAL  PP MS")
}

