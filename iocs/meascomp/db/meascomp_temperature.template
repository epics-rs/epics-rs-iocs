# The mean of every poll's reading over SCAN (upstream
# measCompTemperatureIn.template).
record(ai, "$(P)$(R)") {
    field(SCAN, "$(SCAN=1 second)")
    field(DTYP, "asynFloat64Average")
    field(INP,  "@asyn($(PORT),$(ADDR),1.0)TEMPERATURE_IN_VALUE")
    field(PREC, "$(PREC=2)")
}

record(mbbo, "$(P)$(R)TCType") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1.0)THERMOCOUPLE_TYPE")
    field(ZRST, "Type J")  field(ZRVL, "1")
    field(ONST, "Type K")  field(ONVL, "2")
    field(TWST, "Type T")  field(TWVL, "3")
    field(THST, "Type E")  field(THVL, "4")
    field(FRST, "Type R")  field(FRVL, "5")
    field(FVST, "Type S")  field(FVVL, "6")
    field(SXST, "Type B")  field(SXVL, "7")
    field(SVST, "Type N")  field(SVVL, "8")
    field(VAL,  "0")
    field(PINI, "YES")
}

record(mbbo, "$(P)$(R)Scale") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1.0)TEMPERATURE_SCALE")
    field(ZRST, "Celsius")    field(ZRVL, "1")
    field(ONST, "Fahrenheit") field(ONVL, "2")
    field(TWST, "Kelvin")     field(TWVL, "3")
    field(THST, "Volts")      field(THVL, "4")
    field(FRST, "Noscale")    field(FRVL, "5")
    field(PINI, "YES")
}

# Upstream's UL-for-Windows filter codes; the Linux driver does not use them.
record(mbbo, "$(P)$(R)Filter") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1.0)TEMPERATURE_FILTER")
    field(PINI, "YES")
    field(ZRVL, "0")      field(ZRST, "Filter")
    field(ONVL, "0x400")  field(ONST, "No filter")
}

record(bo, "$(P)$(R)OpenTCDetect") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),1.0)THERMOCOUPLE_OPEN_DETECT")
    field(PINI, "YES")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
}
