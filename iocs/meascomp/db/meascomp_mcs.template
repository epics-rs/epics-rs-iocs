# MCS (Multi-Channel Scaler) control records
# Macros: P (prefix), PORT (asyn port)
#
# The record fields are upstream measCompMCS.template's. What upstream's
# USBCTR_SNL.st does -- read the spectra on DoReadAll, and on the hardware's
# 1 -> 0 transition read them and only then release Acquiring -- is done by
# the DoReadAll / AcquireDone / FinishAcquire records below.

record(bo, "$(P)MCS:EraseAll") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_ERASE")
    field(ZNAM, "Done")
    field(ONAM, "Erase")
    field(VAL,  "1")
    field(FLNK, "$(P)MCS:ReadAllOnce")
}

record(bo, "$(P)MCS:EraseStart") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_ERASE")
    field(ZNAM, "Done")
    field(ONAM, "Erase")
    field(VAL,  "1")
    field(FLNK, "$(P)MCS:StartAll.PROC")
}

record(bo, "$(P)MCS:StartAll") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_START_ACQUIRE")
    field(ZNAM, "Done")
    field(ONAM, "Start")
    field(VAL,  "1")
    field(FLNK, "$(P)MCS:SetAcquiring.PROC")
}

record(bo, "$(P)MCS:SetAcquiring") {
    field(OUT,  "$(P)MCS:Acquiring PP MS")
    field(ZNAM, "Done")
    field(ONAM, "Set")
    field(VAL,  "1")
    field(FLNK, "$(P)MCS:SetClientWait.PROC")
}

# What a client waits on: set with StartAll, cleared only after the spectra
# have been re-read, so `caput -c $(P)MCS:EraseStart 1` returns with the data
# already in the spectrum records.
record(busy, "$(P)MCS:Acquiring") {
    field(ZNAM, "Done")
    field(ONAM, "Acquiring")
}

record(bo, "$(P)MCS:StopAll") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_STOP_ACQUIRE")
    field(ZNAM, "Done")
    field(ONAM, "Stop")
    field(VAL,  "1")
}

# What the driver is doing right now.
record(bi, "$(P)MCS:HardwareAcquiring") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,1.0)MCA_ACQUIRING")
    field(SCAN, "I/O Intr")
    field(ZNAM, "Done")
    field(ONAM, "Acquiring")
    field(FLNK, "$(P)MCS:AcquireDone")
}

# Fires once on the hardware's 1 -> 0 transition.
record(calcout, "$(P)MCS:AcquireDone") {
    field(INPA, "$(P)MCS:HardwareAcquiring  NPP NMS")
    field(CALC, "A")
    field(OOPT, "Transition To Zero")
    field(OUT,  "$(P)MCS:FinishAcquire.PROC  PP")
}

# Read every spectrum, then release Acquiring -- in that order, as the SNL
# program's HardwareAcquiring handler does. Nothing else clears Acquiring.
record(seq, "$(P)MCS:FinishAcquire") {
    field(SELM, "All")
    field(DOL1, "1")  field(LNK1, "$(P)MCS:ReadAllOnce.PROC  PP")
    field(DOL2, "0")  field(LNK2, "$(P)MCS:Acquiring  PP")
}

# Refreshes the spectra once a second while acquiring.
record(bo, "$(P)MCS:ReadAll") {
    field(SCAN, "1 second")
    field(DISV, "0")
    field(SDIS, "$(P)MCS:Acquiring NPP NMS")
    field(ZNAM, "Done")
    field(ONAM, "Read")
    field(FLNK, "$(P)MCS:ReadAllOnce")
}

record(bo, "$(P)MCS:ReadAllOnce") {
    field(VAL,  "1")
    field(OUT,  "$(P)MCS:DoReadAll.VAL PP MS")
}

# Reads the spectra and the absolute time base; it never touches Acquiring.
record(bo, "$(P)MCS:DoReadAll") {
    field(ZNAM, "Done")
    field(ONAM, "Read")
    field(FLNK, "$(P)MCS:ReadFanout")
}

record(fanout, "$(P)MCS:ReadFanout") {
    field(SELM, "All")
    field(LNK0, "$(P)MCS:mca1  PP")
    field(LNK1, "$(P)MCS:mca2  PP")
    field(LNK2, "$(P)MCS:mca3  PP")
    field(LNK3, "$(P)MCS:mca4  PP")
    field(LNK4, "$(P)MCS:mca5  PP")
    field(LNK5, "$(P)MCS:mca6  PP")
    field(LNK6, "$(P)MCS:mca7  PP")
    field(LNK7, "$(P)MCS:mca8  PP")
    field(LNK8, "$(P)MCS:mca9  PP")
    field(LNK9, "$(P)MCS:AbsTimeWF  PP")
    field(FLNK, "$(P)MCS:ClearReadAll")
}

record(bo, "$(P)MCS:ClearReadAll") {
    field(VAL,  "0")
    field(OUT,  "$(P)MCS:DoReadAll.VAL  NPP")
}

# Time bases. The relative one is pushed by the driver whenever Dwell is
# written (C computeMCSTimes); the absolute one is read with the spectra.
record(waveform, "$(P)MCS:TimeWF") {
    field(DTYP, "asynFloat32ArrayIn")
    field(INP,  "@asyn($(PORT),0,1.0)MCS_TIME_WF")
    field(FTVL, "FLOAT")
    field(NELM, "$(MAX_POINTS=2048)")
    field(SCAN, "I/O Intr")
}

record(waveform, "$(P)MCS:AbsTimeWF") {
    field(DTYP, "asynFloat64ArrayIn")
    field(INP,  "@asyn($(PORT),0,1.0)MCS_ABS_TIME_WF")
    field(FTVL, "DOUBLE")
    field(NELM, "$(MAX_POINTS=2048)")
}

# A client that must be released only after it has consumed the data sets
# EnableClientWait; ClientWait is then raised with Acquiring and the client
# clears it when done.
record(bo, "$(P)MCS:EnableClientWait") {
    field(PINI, "YES")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
}

record(bo, "$(P)MCS:SetClientWait") {
    field(DISV, "0")
    field(SDIS, "$(P)MCS:EnableClientWait NPP NMS")
    field(OMSL, "closed_loop")
    field(DOL,  "1")
    field(OUT,  "$(P)MCS:ClientWait PP MS")
    field(ONAM, "SetClientWait")
    field(ZNAM, "Done")
}

record(busy, "$(P)MCS:ClientWait") {
    field(ZNAM, "Done")
    field(ONAM, "Waiting")
}

record(ao, "$(P)MCS:Dwell") {
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_DWELL_TIME")
    field(PREC, "6")
    field(VAL,  "0.001")
    field(PINI, "YES")
}

# The dwell the clock actually runs, written back when a scan starts.
record(ai, "$(P)MCS:Dwell_RBV") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1.0)MCA_DWELL_TIME")
    field(PREC, "6")
    field(SCAN, "I/O Intr")
}

record(longout, "$(P)MCS:NuseAll") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_NUM_CHANNELS")
    field(VAL,  "$(MAX_POINTS=2048)")
    field(DRVL, "1")
    field(DRVH, "$(MAX_POINTS=2048)")
    field(PINI, "YES")
}

record(mbbi, "$(P)MCS:Model") {
    field(DESC, "Model")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,1.0)MODEL")
    field(ZRVL, "0")  field(ZRST, "USB-CTR08")
    field(ONVL, "1")  field(ONST, "USB-CTR04")
    field(PINI, "YES")
}

record(longin, "$(P)MCS:MaxChannels") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,1.0)MCS_MAX_POINTS")
    field(PINI, "YES")
}

record(longout, "$(P)MCS:Prescale") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_PRESCALE")
    field(VAL,  "1")
    field(PINI, "YES")
}

# The MCS always runs triggered. For an untriggered scan leave the trigger
# input unconnected and choose "Low level", which is always satisfied.
record(mbbo, "$(P)MCS:TrigMode") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)TRIGGER_MODE")
    field(ZRVL, "0")  field(ZRST, "Rising edge")
    field(ONVL, "1")  field(ONST, "Falling edge")
    field(TWVL, "6")  field(TWST, "High level")
    field(THVL, "7")  field(THST, "Low level")
    field(PINI, "YES")
}

record(ao, "$(P)MCS:PresetReal") {
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_PRESET_REAL")
    field(PREC, "3")
    field(VAL,  "0")
    field(PINI, "YES")
}

record(ai, "$(P)MCS:ElapsedReal") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,1.0)MCA_ELAPSED_REAL")
    field(PREC, "3")
    field(SCAN, "I/O Intr")
}

record(longin, "$(P)MCS:CurrentChannel") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,1.0)MCS_CURRENT_POINT")
    field(SCAN, "I/O Intr")
}

# Counter that divides an external channel advance by Prescale.
record(mbbo, "$(P)MCS:PrescaleCounter") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCS_PRESCALE_COUNTER")
    field(ZRVL, "0")  field(ZRST, "CTR0")
    field(ONVL, "1")  field(ONST, "CTR1")
    field(TWVL, "2")  field(TWST, "CTR2")
    field(THVL, "3")  field(THST, "CTR3")
    field(FRVL, "4")  field(FRST, "CTR4")
    field(FVVL, "5")  field(FVST, "CTR5")
    field(SXVL, "6")  field(SXST, "CTR6")
    field(SVVL, "7")  field(SVST, "CTR7")
    field(PINI, "YES")
}

record(mbbo, "$(P)MCS:Point0Action") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCS_POINT0_ACTION")
    field(ZRVL, "0")  field(ZRST, "Clear")
    field(ONVL, "1")  field(ONST, "No clear")
    field(TWVL, "2")  field(TWST, "Skip")
    field(PINI, "YES")
}

record(mbbo, "$(P)MCS:ChannelAdvance") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1.0)MCA_CH_ADV_SOURCE")
    field(ZRST, "Internal")  field(ZRVL, "0")
    field(ONST, "External")  field(ONVL, "1")
    field(PINI, "YES")
}

# Per-counter MCS enable. The driver reads MCS_COUNTER_ENABLE as one
# bitmask (bit i = counter i, bit 8 = the digital I/O channel); the bo
# records below drive the individual bits of it.
record(mbboDirect, "$(P)MCS:MCSCounterEnable") {
    field(DTYP, "asynUInt32Digital")
    field(OUT,  "@asynMask($(PORT),0,0xFFFFFFFF)MCS_COUNTER_ENABLE")
    field(VAL,  "0x1FF")
    field(PINI, "YES")
}

record(bo, "$(P)MCS:MCSCounter1Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B0 PP")
    field(PINI, "YES")
}

record(bo, "$(P)MCS:MCSCounter2Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B1 PP")
    field(PINI, "YES")
}

record(bo, "$(P)MCS:MCSCounter3Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B2 PP")
    field(PINI, "YES")
}

record(bo, "$(P)MCS:MCSCounter4Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B3 PP")
    field(PINI, "YES")
}

record(bo, "$(P)MCS:MCSCounter5Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B4 PP")
    field(PINI, "YES")
}

record(bo, "$(P)MCS:MCSCounter6Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B5 PP")
