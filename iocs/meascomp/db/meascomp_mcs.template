record(bo, "$(P)MCS:MCSCounter7Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B6 PP")
    field(PINI, "YES")
