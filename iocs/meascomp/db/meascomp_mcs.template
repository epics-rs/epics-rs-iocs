record(bo, "$(P)MCS:MCSCounter8Enable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B7 PP")
    field(PINI, "YES")
