record(bo, "$(P)MCS:MCSDIOEnable") {
    field(ZNAM, "No")  field(ONAM, "Yes")  field(VAL, "1")
    field(OUT,  "$(P)MCS:MCSCounterEnable.B8 PP")
    field(PINI, "YES")
}
