$(P)PulseGen2DutyCycle
$(P)PulseGen2Delay
$(P)PulseGen2Count
$(P)PulseGen2IdleState
$(P)PulseGen2Run
$(P)PulseGen3Period
$(P)PulseGen3DutyCycle
$(P)PulseGen3Delay
$(P)PulseGen3Count
$(P)PulseGen3IdleState
$(P)PulseGen3Run
$(P)PulseGen4Period
$(P)PulseGen4DutyCycle
