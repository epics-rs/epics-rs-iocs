$(P)Bd8

# DutyCycle, not upstream's Width: CalcWidth derives Width from DutyCycle
# and overwrites it at init (doc/upstream-c-defects.md #228).
$(P)PulseGen1Period
$(P)PulseGen1DutyCycle
$(P)PulseGen1Delay
$(P)PulseGen1Count
$(P)PulseGen1IdleState
$(P)PulseGen1Run
