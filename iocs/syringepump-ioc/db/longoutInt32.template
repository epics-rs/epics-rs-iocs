# longout record template for register inputs
record(longout,"$(P)$(R)") {
    field(DTYP,"asynInt32")
    field(DESC, "$(DESC=)")
    field(OUT,"@asyn($(PORT) $(OFFSET))$(DATA_TYPE)")
    field(PINI,"$(PINI=NO)")
}
