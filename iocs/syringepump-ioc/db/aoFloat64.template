# Copied verbatim from modbus R3-4 modbusApp/Db/aoFloat64.template. See
# aiFloat64.template's header comment for why this is a local copy
# rather than a MODBUS-macro reference.
# ao record template for register outputs
record(ao, "$(P)$(R)") {
    field(DTYP, "asynFloat64")
    field(DESC, "$(DESC=)")
    field(OUT,  "@asyn($(PORT) $(OFFSET))$(DATA_TYPE)")
    field(HOPR, "$(HOPR=0)")
    field(LOPR, "$(LOPR=0)")
    field(PREC, "$(PREC=0)")
    field(PINI, "$(PINI=NO)")
}

