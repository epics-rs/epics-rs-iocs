# longin record template for register inputs
record(longin,"$(P)$(R)") {
    field(DTYP,"asynInt32")
    field(DESC, "$(DESC=)")
    field(INP,"@asyn($(PORT) $(OFFSET))$(DATA_TYPE)")
    field(SCAN, "$(SCAN)")
}
