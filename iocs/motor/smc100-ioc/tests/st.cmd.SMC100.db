# c-expansion of st.cmd.SMC100 over the C sources, the records of st.cmd.SMC100.dbl:
# dbl of motor R7-4-5 motorNewport iocBoot/iocNewport st.cmd.SMC100
record(motor, "IOC:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, ".5")
    field(DESC, "GTS30V")
    field(DHLM, "25")
    field(DIR, "Pos")
    field(DLLM, "-5")
    field(DTYP, "asynMotor")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, "0.00001")
    field(OUT, "@asyn(SMC100_1,0)")
    field(PREC, "6")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "1")
}
record(longout, "IOC:m1Direction") {
    field(DESC, "m1 direction")
    field(DOL, "IOC:m1.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(SMC100_1,0)MOTOR_REC_DIRECTION")
}
record(ao, "IOC:m1Offset") {
    field(DESC, "m1 offset")
    field(DOL, "IOC:m1.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(SMC100_1,0)MOTOR_REC_OFFSET")
    field(PREC, "6")
}
record(ao, "IOC:m1Resolution") {
    field(DESC, "m1 resolution")
    field(DOL, "IOC:m1.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(SMC100_1,0)MOTOR_REC_RESOLUTION")
    field(PREC, "6")
}
