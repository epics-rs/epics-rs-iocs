# Newport SMC100 axis ADDR of PORT. The driver boundary is raw steps of
# SMC100CreateController's eguPerStep, so MRES must equal it. Defaults are
# C's motor.substitutions.SMC100.
record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR=0))")
    field(SCAN, "Passive")
    field(DIR,  "$(DIR=Pos)")
    field(VELO, "$(VELO=1)")
    field(VBAS, "$(VBAS=0)")
    field(ACCL, "$(ACCL=.2)")
    field(BDST, "$(BDST=0)")
    field(BVEL, "$(BVEL=.5)")
    field(BACC, "$(BACC=.2)")
    field(DHLM, "$(HLM=25)")
    field(DLLM, "$(LLM=-5)")
    field(MRES, "$(MRES=0.00001)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=6)")
}
