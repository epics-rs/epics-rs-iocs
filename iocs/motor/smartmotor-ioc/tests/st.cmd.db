# c-expansion of st.cmd over the C sources, the records of st.cmd.dbl:
# dbl of motor R7-4-5 motorSmartMotor iocBoot/iocSmartMotor st.cmd
record(bi, "smartMotor:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "smartMotor:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "smartMotor:alldone")
    field(INPB, "smartMotor:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "smartMotor:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "smartMotor:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "SmartMotor")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "smartMotor:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "smartMotor:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "smartMotor:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "smartMotor:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "smartMotor:m1.TWV")
    field(INPC, "smartMotor:m1.MRES")
    field(INPD, "smartMotor:m1.HLM")
    field(INPE, "smartMotor:m1.LLM")
    field(OUT, "smartMotor:m1.TWV")
}
record(calcout, "smartMotor:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "smartMotor:m1.S")
    field(INPC, "smartMotor:m1.SBAS")
    field(INPD, "smartMotor:m1.SMAX")
    field(OUT, "smartMotor:m1.S")
}
record(longout, "smartMotor:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "smartMotor:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
