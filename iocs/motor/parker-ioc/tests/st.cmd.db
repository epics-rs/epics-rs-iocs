# c-expansion of st.cmd over the C sources, the records of st.cmd.dbl:
# dbl of motor R7-4-5 motorParker iocBoot/iocParker st.cmd
record(bi, "parker:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "parker:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "parker:alldone")
    field(INPB, "parker:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "parker:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "parker:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "PC6K")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "2.5e-4")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "parker:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "parker:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "parker:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "parker:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "parker:m1.TWV")
    field(INPC, "parker:m1.MRES")
    field(INPD, "parker:m1.HLM")
    field(INPE, "parker:m1.LLM")
    field(OUT, "parker:m1.TWV")
}
record(calcout, "parker:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "parker:m1.S")
    field(INPC, "parker:m1.SBAS")
    field(INPD, "parker:m1.SMAX")
    field(OUT, "parker:m1.S")
}
record(motor, "parker:m2") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 2")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "PC6K")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "2.5e-4")
    field(OUT, "#C0 S1 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "parker:m2_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "parker:m2_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "parker:m2.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "parker:m2_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "parker:m2.TWV")
    field(INPC, "parker:m2.MRES")
    field(INPD, "parker:m2.HLM")
    field(INPE, "parker:m2.LLM")
    field(OUT, "parker:m2.TWV")
}
record(calcout, "parker:m2_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "parker:m2.S")
    field(INPC, "parker:m2.SBAS")
    field(INPD, "parker:m2.SMAX")
    field(OUT, "parker:m2.S")
}
record(longout, "parker:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "parker:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
