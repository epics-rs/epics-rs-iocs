# C's iocParker motor.substitutions.acr on this IOC's one controller, P and
# PORT from st.acr.cmd. C's binary I/O rows are named $(P)$(PORT):<R>, P
# IOC:.
file "$(MOTOR)/db/basic_asyn_motor.db"
{
pattern
{N,  M,       DTYP,         ADDR,  DESC,          EGU,  DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,     PREC,  DHLM,  DLLM,  INIT}
{1,  "m$(N)", "asynMotor",  0,     "motor $(N)",  mm,   Pos,  .05,   .01,   .5,    0,     1,     .2,    1.25e-7,  5,     200,   -2,    ""}
}

file "$(PARKER_IOC)/db/ACRAux.template"
{
pattern
{R,    ADDR}
{m1:,  0}
}

file "$(PARKER_IOC)/db/ACRAuxLi.template"
{
pattern
{R,             SCAN}
{"$(PORT):li",  "I/O Intr"}
}

file "$(PARKER_IOC)/db/ACRAuxRead.template"
{
pattern
{R,               SCAN}
{"$(PORT):Read",  "1 second"}
}

file "$(PARKER_IOC)/db/ACRAuxBi.template"
{
pattern
{R,                  MASK,        SCAN}
{"$(PORT):bi0",      0x00000001, "I/O Intr"}
{"$(PORT):bi1",      0x00000002, "I/O Intr"}
{"$(PORT):bi2",      0x00000004, "I/O Intr"}
{"$(PORT):bi3",      0x00000008, "I/O Intr"}
{"$(PORT):bi4",      0x00000010, "I/O Intr"}
{"$(PORT):bi5",      0x00000020, "I/O Intr"}
{"$(PORT):bi6",      0x00000040, "I/O Intr"}
{"$(PORT):bi7",      0x00000080, "I/O Intr"}
{"$(PORT):bi8",      0x00000100, "I/O Intr"}
{"$(PORT):bi9",      0x00000200, "I/O Intr"}
{"$(PORT):bi10",     0x00000400, "I/O Intr"}
{"$(PORT):bi11",     0x00000800, "I/O Intr"}
{"$(PORT):bi12",     0x00001000, "I/O Intr"}
{"$(PORT):bi13",     0x00002000, "I/O Intr"}
{"$(PORT):bi14",     0x00004000, "I/O Intr"}
{"$(PORT):bi15",     0x00008000, "I/O Intr"}
{"$(PORT):bi16",     0x00010000, "I/O Intr"}
{"$(PORT):bi17",     0x00020000, "I/O Intr"}
{"$(PORT):bi18",     0x00040000, "I/O Intr"}
{"$(PORT):bi19",     0x00080000, "I/O Intr"}
{"$(PORT):bi20",     0x00100000, "I/O Intr"}
{"$(PORT):bi21",     0x00200000, "I/O Intr"}
{"$(PORT):bi22",     0x00400000, "I/O Intr"}
{"$(PORT):bi23",     0x00800000, "I/O Intr"}
{"$(PORT):bi24",     0x01000000, "I/O Intr"}
{"$(PORT):bi25",     0x02000000, "I/O Intr"}
{"$(PORT):bi26",     0x04000000, "I/O Intr"}
{"$(PORT):bi27",     0x08000000, "I/O Intr"}
{"$(PORT):bi28",     0x10000000, "I/O Intr"}
{"$(PORT):bi29",     0x20000000, "I/O Intr"}
{"$(PORT):bi30",     0x40000000, "I/O Intr"}
{"$(PORT):bi31",     0x80000000, "I/O Intr"}
}

