# The model-1 Parker 6K (drvPC6K.cc): one motor record per axis, axis S+1
# of card C. Distances, speeds and accelerations go to the 6K in steps.

record(motor, "$(P)$(M)") {
    field(DTYP, "PC6K")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1000.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=1000000.0)")
    field(DLLM, "$(LLM=-1000000.0)")
    field(MRES, "$(MRES=1.0)")
    field(EGU,  "$(EGU=steps)")
    field(PREC, "$(PREC=0)")
    field(INIT, "$(INIT=)")
    field(PREM, "$(PREM=)")
    field(POST, "$(POST=)")
}
