# Parker ACR / Aries: one motor record per axis, ADDR the 0-based axis index
# of port PORT (axis name AXIS<ADDR>).
#
# The record's steps are the controller's pulses; the driver divides them by
# the PPU it reads. MRES and the motion fields are the C example's
# (motor.substitutions.acr).

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=.05)")
    field(VBAS, "$(VBAS=.01)")
    field(ACCL, "$(ACCL=.5)")
    field(BVEL, "$(BVEL=1)")
    field(BACC, "$(BACC=.2)")
    field(DHLM, "$(HLM=200)")
    field(DLLM, "$(LLM=-2)")
    field(MRES, "$(MRES=1.25e-7)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=5)")
}
