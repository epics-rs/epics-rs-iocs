# PI_E517.substitutions, as C's iocPI has for its other controllers,
# on this IOC's axes, P and C from st.cmd; the values are the motor
# record this IOC had before.
#
# PI E-517: one motor record per axis. DTYP is "PIE517", OUT #C$(C) S$(S); signal 0/1/2 = command digits 1/2/3,
# in the order they responded to the connect-time POS? probe.
#
# Like the E-516 the driver works in POS_RES-sized steps (1 step = 0.001 um),
# so MRES = 1 and EGU is steps. Closed-loop piezo (NTM=No, no home, no
# set-position).
file "$(MOTOR)/db/motor.db"
{
pattern
{M,        DTYP,      S,  DESC,  EGU,    DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,     DLLM,      INIT}
{"e517a",  "PIE517",  0,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"e517b",  "PIE517",  1,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"e517c",  "PIE517",  2,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
}
