# PI_E516.substitutions, as C's iocPI has for its other controllers,
# on this IOC's axes, P and C from st.cmd; the values are the motor
# record this IOC had before.
#
# PI E-516: one motor record per axis. DTYP is "PIE516", OUT #C$(C) S$(S); signal 0/1/2 = letters A/B/C, in the
# order they responded to the connect-time POS? probe.
#
# The E-516 driver works in POS_RES-sized steps (1 step = 0.001 um; the driver
# multiplies outgoing positions by POS_RES and divides POS? micrometres back by
# it), so MRES = 1 and EGU is steps. The E-516 is a closed-loop piezo (NTM=No,
# no home, no set-position).
file "$(MOTOR)/db/motor.db"
{
pattern
{M,        DTYP,      S,  DESC,  EGU,    DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,     DLLM,      INIT}
{"e516a",  "PIE516",  0,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"e516b",  "PIE516",  1,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"e516c",  "PIE516",  2,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
}
