# PI_C630.substitutions, as C's iocPI has for its other controllers,
# on this IOC's axes, P and C from st.cmd; the values are the motor
# record this IOC had before.
#
# PI C-630: one motor record per daisy-chained axis, DTYP "PI C630" with OUT
# #C$(C) S$(S); the wire address is $(S)+1, i.e. 1-9.
#
# The C-630 works in raw controller counts (MA/MR/TP are integer counts, no
# separate EGU scaling in the driver), so MRES = 1 and EGU = counts.
file "$(MOTOR)/db/motor.db"
{
pattern
{M,         DTYP,       S,  DESC,  EGU,     DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,     DLLM,      INIT}
{"c630_1",  "PI C630",  0,  "",    counts,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"c630_2",  "PI C630",  1,  "",    counts,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"c630_3",  "PI C630",  2,  "",    counts,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
}
