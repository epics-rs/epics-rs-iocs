# C's iocPI PI_E662.substitutions, P and C from st.cmd.
#
# PI E-662: one motor record for the controller's single axis, DTYP "PIC662"
# with OUT #C$(C) S0. The E-662 has no velocity/accel/jog/home wire commands;
# only absolute and relative moves reach the controller.
file "$(MOTOR)/db/motor.db"
{
pattern
{N,  M,        DTYP,      S,  DESC,          EGU,      DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,  DLLM,  INIT}
{4,  "m$(N)",  "PIC662",  0,  "motor $(N)",  degrees,  Pos,  1,     .1,    .2,    0,     1,     .2,    0.01,  5,     100,   -100,  ""}
}
