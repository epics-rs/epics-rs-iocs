# C's iocPI PI_C844.substitutions, P and C from st.cmd.
#
# PI C-844: one motor record per axis. DTYP is "PIC844", OUT #C$(C) S$(S) ; the
# wire axis is $(S)+1, i.e. 1-4, selected by an "AXIS n;" command prefix.
file "$(MOTOR)/db/motor.db"
{
pattern
{N,  M,        DTYP,      S,  DESC,          EGU,      DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,  DLLM,  INIT}
{1,  "m$(N)",  "PIC844",  0,  "motor $(N)",  degrees,  Pos,  1,     .1,    .2,    0,     1,     .2,    0.01,  5,     100,   -100,  ""}
}
