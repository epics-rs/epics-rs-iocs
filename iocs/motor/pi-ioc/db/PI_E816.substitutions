# C's iocPI PI_E816.substitutions on this IOC's axes, P and C from
# st.cmd; the values are the motor record this IOC had before.
#
# PI E-816: one motor record per axis. DTYP is "PIE816", OUT #C$(C) S$(S); signal 0..11 = command letters A..L,
# in the order they responded to the connect-time POS? probe.
#
# The driver works in POS_RES-sized steps (1 step = 0.0001 um), so MRES = 1 and
# EGU is steps. Closed-loop piezo (NTM=No, no home, no set-position; stop is a
# zero relative move).
file "$(MOTOR)/db/motor.db"
{
pattern
{M,        DTYP,      S,  DESC,  EGU,    DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,     DLLM,      INIT}
{"e816a",  "PIE816",  0,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"e816b",  "PIE816",  1,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
{"e816c",  "PIE816",  2,  "",    steps,  Pos,  1000,  0,     0.2,   0,     0,     .5,    1,     0,     1000000,  -1000000,  ""}
}
