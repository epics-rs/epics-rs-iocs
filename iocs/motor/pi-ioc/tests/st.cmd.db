# c-expansion of st.cmd over the C sources, the records of st.cmd.dbl:
# dbl of motor R7-4-5 motorPI iocBoot/iocPI st.cmd
record(bi, "pi:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "pi:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "pi:alldone")
    field(INPB, "pi:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "pi:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "pi:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "PIC844")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "pi:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "pi:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "pi:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "pi:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "pi:m1.TWV")
    field(INPC, "pi:m1.MRES")
    field(INPD, "pi:m1.HLM")
    field(INPE, "pi:m1.LLM")
    field(OUT, "pi:m1.TWV")
}
record(calcout, "pi:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "pi:m1.S")
    field(INPC, "pi:m1.SBAS")
    field(INPD, "pi:m1.SMAX")
    field(OUT, "pi:m1.S")
}
