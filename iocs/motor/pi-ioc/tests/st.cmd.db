record(longout, "pi:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "pi:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
