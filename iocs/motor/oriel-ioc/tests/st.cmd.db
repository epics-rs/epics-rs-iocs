# c-expansion of st.cmd over the C sources, the records of st.cmd.dbl:
# dbl of motor R7-4-5 motorOriel iocBoot/iocOriel st.cmd
record(bi, "oriel:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "oriel:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "oriel:alldone")
    field(INPB, "oriel:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "oriel:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "oriel:m1") {
    field(ACCL, "1.")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "999999")
    field(DIR, "Pos")
    field(DLLM, "0.1")
    field(DTYP, "EMC18011")
    field(EGU, "microns")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "#C0 S0 @")
    field(PREC, "3")
    field(RSTM, "NearZero")
    field(SDIS, "oriel:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0.")
    field(VELO, "10")
}
record(bo, "oriel:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "oriel:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "oriel:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "oriel:m1.TWV")
    field(INPC, "oriel:m1.MRES")
    field(INPD, "oriel:m1.HLM")
    field(INPE, "oriel:m1.LLM")
    field(OUT, "oriel:m1.TWV")
}
record(calcout, "oriel:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "oriel:m1.S")
    field(INPC, "oriel:m1.SBAS")
    field(INPD, "oriel:m1.SMAX")
    field(OUT, "oriel:m1.S")
}
record(longout, "oriel:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "oriel:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
