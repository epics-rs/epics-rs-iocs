# Oriel Encoder Mike 18011: one motor record per axis. Load once per axis with
# S = 0-based signal (DTYP "EMC18011", OUT #C$(C) S$(S)); the driver maps index
# 0,1,2 to controller motors 1,2,3.
#
# The controller works in millimetres (position query and G/T moves are mm).
# The driver converts record steps with C's drive_resolution 0.01 mm, so MRES
# must stay 0.01 for EGU mm. VELO (mm/s) feeds the V command; done and the
# plus/minus limit switches come from the Z status character. The controller
# only reports position when stopped, and only for the currently selected motor.

record(motor, "$(P)$(M)") {
    field(DTYP, "EMC18011")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=25.0)")
    field(DLLM, "$(LLM=-25.0)")
    field(MRES, "$(MRES=0.01)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=3)")
}
