# C's iocOriel EMC18011.substitutions row on each of this IOC's three axes,
# P from st.cmd. Signal 0,1,2 is controller motor 1,2,3. The controller
# only reports position when stopped, and only for the currently selected
# motor.
file "$(MOTOR)/db/motor.db"
{
pattern
{N,  M,        DTYP,        S,  DESC,          EGU,      DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,    DLLM,  INIT}
{1,  "m$(N)",  "EMC18011",  0,  "motor $(N)",  microns,  Pos,  10,    0.,    1.,    0,     1,     .2,    0.01,  3,     999999,  0.1,   ""}
{2,  "m$(N)",  "EMC18011",  1,  "motor $(N)",  microns,  Pos,  10,    0.,    1.,    0,     1,     .2,    0.01,  3,     999999,  0.1,   ""}
{3,  "m$(N)",  "EMC18011",  2,  "motor $(N)",  microns,  Pos,  10,    0.,    1.,    0,     1,     .2,    0.01,  3,     999999,  0.1,   ""}
}
