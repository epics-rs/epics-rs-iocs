# Newport MM3000: one motor record per axis, signal S of card C as in C's
# basic_motor.db; signal 0,1,2,... is controller axis 1,2,3,...
# Values from C's MM3000.substitutions. The driver jogs by moving to
# DHLM/DLLM, so set real soft limits.

record(motor, "$(P)$(M)") {
    field(DTYP, "MM3000")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1)")
    field(VBAS, "$(VBAS=0.1)")
    field(ACCL, "$(ACCL=0.2)")
    field(BDST, "$(BDST=0)")
    field(BVEL, "$(BVEL=1)")
    field(BACC, "$(BACC=0.2)")
    field(DHLM, "$(HLM=100)")
    field(DLLM, "$(LLM=-100)")
    field(MRES, "$(MRES=5e-5)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=5)")
}
