# The model-1 Aerotech Soloist (drvSoloist.cc): the one axis of card C, in
# steps; the driver scales them by the PosScaleFactor it reads.

record(motor, "$(P)$(M)") {
    field(DTYP, "Soloist")
    field(OUT,  "#C$(C) S0 @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1000.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=1000000.0)")
    field(DLLM, "$(LLM=-1000000.0)")
    field(MRES, "$(MRES=1.0)")
    field(EGU,  "$(EGU=steps)")
    field(PREC, "$(PREC=0)")
    field(INIT, "$(INIT=)")
    field(PREM, "$(PREM=)")
    field(POST, "$(POST=)")
}
