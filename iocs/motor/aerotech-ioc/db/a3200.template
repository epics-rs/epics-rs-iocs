# Aerotech A3200: one motor record per axis, ADDR the controller axis index
# on the drvAsynMotorConfigure port PORT.
#
# The driver works in the A3200's user units (the C stepSize = 1/CountsPerUnit
# scaling cancels at the EGU boundary) and EGU is whatever the controller's
# CountsPerUnit is configured for (e.g. mm or deg). MRES is the record's step
# (RRBV is an integer count and RDBD >= MRES), so set it to 1/CountsPerUnit;
# the default is the C example's (a3.asyn.motor.substitutions). VELO/ACCL are in
# those user units per second / per second^2.

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=10.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=-100.0)")
    field(MRES, "$(MRES=0.0004)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
