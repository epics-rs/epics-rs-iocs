# Aerotech A3200: one motor record per axis, ADDR the controller axis index
# on the drvAsynMotorConfigure port PORT.
#
# The driver scales the record's steps by stepSize = 1/CountsPerUnit into the
# controller's user units (e.g. mm or deg), as C; MRES is the C example's
# (a3.asyn.motor.substitutions).

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=10.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=-100.0)")
    field(MRES, "$(MRES=0.0004)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
