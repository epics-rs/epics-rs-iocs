# c-expansion of st.cmd over the C sources, the records of iocAerotech.dbl:
# dbl of motor R7-4-5 motorAerotech iocBoot/iocAerotech st.cmd
record(bi, "aerotech:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "aerotech:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "aerotech:alldone")
    field(INPB, "aerotech:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "aerotech:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "aerotech:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "0")
    field(DIR, "Pos")
    field(DLLM, "0")
    field(DTYP, "asynMotor")
    field(EGU, "mm")
    field(INIT, "SCURVE 100")
    field(MRES, "1.25E-5")
    field(OUT, "@asyn(AeroE1,0)")
    field(PREC, "7")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "aerotech:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, ".1")
}
record(longout, "aerotech:m1Direction") {
    field(DESC, "m1 direction")
    field(DOL, "aerotech:m1.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(AeroE1,0)MOTOR_REC_DIRECTION")
}
record(ao, "aerotech:m1Offset") {
    field(DESC, "m1 offset")
    field(DOL, "aerotech:m1.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(AeroE1,0)MOTOR_REC_OFFSET")
    field(PREC, "7")
}
record(ao, "aerotech:m1Resolution") {
    field(DESC, "m1 resolution")
    field(DOL, "aerotech:m1.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(AeroE1,0)MOTOR_REC_RESOLUTION")
    field(PREC, "7")
}
record(bo, "aerotech:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "aerotech:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "aerotech:m1_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "aerotech:m1.TWV")
    field(INPC, "aerotech:m1.MRES")
    field(INPD, "aerotech:m1.HLM")
    field(INPE, "aerotech:m1.LLM")
    field(OUT, "aerotech:m1.TWV")
}
record(calcout, "aerotech:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "aerotech:m1.S")
    field(INPC, "aerotech:m1.SBAS")
    field(INPD, "aerotech:m1.SMAX")
    field(OUT, "aerotech:m1.S")
}
record(motor, "aerotech:m2") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 2")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "Soloist")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "2.5e-4")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "aerotech:m2_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "aerotech:m2_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "aerotech:m2.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "aerotech:m2_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "aerotech:m2.TWV")
    field(INPC, "aerotech:m2.MRES")
    field(INPD, "aerotech:m2.HLM")
    field(INPE, "aerotech:m2.LLM")
    field(OUT, "aerotech:m2.TWV")
}
record(calcout, "aerotech:m2_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "aerotech:m2.S")
    field(INPC, "aerotech:m2.SBAS")
    field(INPD, "aerotech:m2.SMAX")
    field(OUT, "aerotech:m2.S")
}
record(longout, "aerotech:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "aerotech:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
