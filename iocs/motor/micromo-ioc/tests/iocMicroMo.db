# c-expansion of st.cmd over the C sources, the records of iocMicroMo.dbl:
# dbl of motor R7-4-5 motorMicroMo iocBoot/iocMicroMo st.cmd
record(bi, "microMo:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "microMo:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "microMo:alldone")
    field(INPB, "microMo:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "microMo:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "microMo:m1") {
    field(ACCL, ".1")
    field(ACCU, "0")
    field(BACC, "0.1")
    field(BDST, "0")
    field(BVEL, "0.01")
    field(DESC, "m1")
    field(DHLM, "3000000.0")
    field(DIR, "Pos")
    field(DLLM, "-300000.0")
    field(DTYP, "asynMotor")
    field(EGU, "rev")
    field(INIT, "")
    field(MRES, "0.000015798786653")
    field(OUT, "@asyn(MVP1,0)")
    field(PREC, "4")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "microMo:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0.0")
    field(VELO, "0.025")
}
record(longout, "microMo:m1Direction") {
    field(DESC, "m1 direction")
    field(DOL, "microMo:m1.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MVP1,0)MOTOR_REC_DIRECTION")
}
record(ao, "microMo:m1Offset") {
    field(DESC, "m1 offset")
    field(DOL, "microMo:m1.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MVP1,0)MOTOR_REC_OFFSET")
    field(PREC, "4")
}
record(ao, "microMo:m1Resolution") {
    field(DESC, "m1 resolution")
    field(DOL, "microMo:m1.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MVP1,0)MOTOR_REC_RESOLUTION")
    field(PREC, "4")
}
record(bo, "microMo:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "microMo:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "microMo:m1_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "microMo:m1.TWV")
    field(INPC, "microMo:m1.MRES")
    field(INPD, "microMo:m1.HLM")
    field(INPE, "microMo:m1.LLM")
    field(OUT, "microMo:m1.TWV")
}
record(calcout, "microMo:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "microMo:m1.S")
    field(INPC, "microMo:m1.SBAS")
    field(INPD, "microMo:m1.SMAX")
    field(OUT, "microMo:m1.S")
}
record(longout, "microMo:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "microMo:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
