# Newport MM4000/4005/4006: one motor record per axis, signal S of card C as
# in C's basic_motor.db; signal 0,1,2,... is controller axis 1,2,3,...
# Positions travel the driver boundary in EGU (controller units, mm/deg)
# directly; MRES only sets the record's raw-count resolution
# (display/deadband granularity).

record(motor, "$(P)$(M)") {
    field(DTYP, "MM4000")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1.0)")
    field(ACCL, "$(ACCL=0.5)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=-100.0)")
    field(MRES, "$(MRES=0.0001)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
