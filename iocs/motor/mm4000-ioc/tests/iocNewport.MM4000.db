# c-expansion of st.cmd, MM4000.cmd over the C sources, the records of iocNewport.MM4000.dbl:
# dbl of motor R7-4-5 motorNewport iocBoot/iocNewport st.cmd with < MM4000.cmd
record(bi, "newport:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "newport:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "newport:alldone")
    field(INPB, "newport:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "newport:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "newport:m11") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 11")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "MM4000")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, "1e-5")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "newport:m11_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "newport:m11_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "newport:m11.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "newport:m11_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "newport:m11.TWV")
    field(INPC, "newport:m11.MRES")
    field(INPD, "newport:m11.HLM")
    field(INPE, "newport:m11.LLM")
    field(OUT, "newport:m11.TWV")
}
record(calcout, "newport:m11_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "newport:m11.S")
    field(INPC, "newport:m11.SBAS")
    field(INPD, "newport:m11.SMAX")
    field(OUT, "newport:m11.S")
}
