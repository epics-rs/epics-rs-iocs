# Newport HXP hexapod: one motor record per hexapod coordinate.
# X/Y/Z are translations (mm), U/V/W rotations (deg). The driver converts
# record steps with C HXPDriver's hardcoded MRES 0.00001, so MRES must stay
# at that value.

record(motor, "$(P)$(MX)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),0)")
    field(SCAN, "Passive")
    field(DHLM, "$(HLM=50)")
    field(DLLM, "$(LLM=-50)")
    field(MRES, "$(MRES=0.00001)")
    field(EGU,  "mm")
    field(PREC, "$(PREC=5)")
}

