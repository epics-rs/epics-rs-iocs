record(motor, "xxx:hxp:c0:m1") {
    field(ACCL, ".5")
    field(ACCU, "0")
    field(BACC, "2")
    field(BDST, "0")
    field(BVEL, "1.0")
    field(DESC, "X")
    field(DHLM, "0")
    field(DIR, "Pos")
    field(DLLM, "0")
    field(DTYP, "asynMotor")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, "0.00001")
    field(OUT, "@asyn(HXP1,0)")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(RTRY, "0")
    field(SDIS, "xxx:hxp:c0:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, ".05")
    field(VELO, "3.")
}
