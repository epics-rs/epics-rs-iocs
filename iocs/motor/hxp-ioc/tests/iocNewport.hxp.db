# field values of motor R7-4-5 motorNewport iocBoot/iocNewport st.cmd with < motor.cmd.hxp
# c-expansion of st.cmd, motor.cmd.hxp from the C sources; its names are iocNewport.hxp.dbl's
record(bi, "newport:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "newport:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "newport:alldone")
    field(INPB, "newport:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "newport:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(longout, "newport:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "newport:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
