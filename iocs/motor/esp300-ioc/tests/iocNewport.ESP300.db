record(longout, "newport:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "newport:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
