# Newport ESP100/ESP300/ESP301: one motor record per axis, signal S of card C
# as in C's basic_motor.db; signal 0,1,2,... is controller axis 1,2,3,...
# The driver boundary is raw steps: MRES must equal the axis drive
# resolution (FR?/QS? or SU?), as the motorNewport README says. Defaults
# are C's ESP300.substitutions.

record(motor, "$(P)$(M)") {
    field(DTYP, "ESP300")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(DIR,  "$(DIR=Pos)")
    field(VELO, "$(VELO=1)")
    field(VBAS, "$(VBAS=.1)")
    field(ACCL, "$(ACCL=.2)")
    field(BDST, "$(BDST=0)")
    field(BVEL, "$(BVEL=1)")
    field(BACC, "$(BACC=.2)")
    field(DHLM, "$(HLM=100)")
    field(DLLM, "$(LLM=-100)")
    field(MRES, "$(MRES=5e-5)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=5)")
}
