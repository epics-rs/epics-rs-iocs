# c-expansion of st.cmd over the C sources, the records of iocAcsTech80.dbl:
# dbl of motor R7-4-5 motorAcsTech80 iocBoot/iocAcsTech80 st.cmd
record(bi, "acsTech80:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "acsTech80:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "acsTech80:alldone")
    field(INPB, "acsTech80:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "acsTech80:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "acsTech80:m1") {
    field(ACCL, "1.")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "Motor M1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "SPiiPlus")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, "1e-3")
    field(OUT, "#C0 S0 @")
    field(PREC, "3")
    field(RSTM, "NearZero")
    field(SDIS, "acsTech80:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0.")
    field(VELO, "10")
}
record(bo, "acsTech80:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "acsTech80:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "acsTech80:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "acsTech80:m1.TWV")
    field(INPC, "acsTech80:m1.MRES")
    field(INPD, "acsTech80:m1.HLM")
    field(INPE, "acsTech80:m1.LLM")
    field(OUT, "acsTech80:m1.TWV")
}
record(calcout, "acsTech80:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "acsTech80:m1.S")
    field(INPC, "acsTech80:m1.SBAS")
    field(INPD, "acsTech80:m1.SMAX")
    field(OUT, "acsTech80:m1.S")
}
record(motor, "acsTech80:m2") {
    field(ACCL, "1.")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "Motor M2")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "SPiiPlus")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, "1e-3")
    field(OUT, "#C0 S1 @")
    field(PREC, "3")
    field(RSTM, "NearZero")
    field(SDIS, "acsTech80:m2_able.VAL")
    field(TWV, "1")
    field(VBAS, "0.")
    field(VELO, "10")
}
record(bo, "acsTech80:m2_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "acsTech80:m2.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "acsTech80:m2_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "acsTech80:m2.TWV")
    field(INPC, "acsTech80:m2.MRES")
    field(INPD, "acsTech80:m2.HLM")
    field(INPE, "acsTech80:m2.LLM")
    field(OUT, "acsTech80:m2.TWV")
}
record(calcout, "acsTech80:m2_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "acsTech80:m2.S")
    field(INPC, "acsTech80:m2.SBAS")
    field(INPD, "acsTech80:m2.SMAX")
    field(OUT, "acsTech80:m2.S")
}
record(longout, "acsTech80:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "acsTech80:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
