# c-expansion of st.cmd over the C sources, the records of iocKohzu.dbl:
# dbl of motor R7-4-5 motorKohzu iocBoot/iocKohzu st.cmd
record(bi, "kohzu:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "kohzu:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "kohzu:alldone")
    field(INPB, "kohzu:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "kohzu:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "kohzu:m1") {
    field(ACCL, "1.")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "SC-800")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "1e-3")
    field(OUT, "#C0 S0 @")
    field(PREC, "3")
    field(RSTM, "NearZero")
    field(SDIS, "kohzu:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0.")
    field(VELO, "10")
}
record(bo, "kohzu:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "kohzu:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "kohzu:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "kohzu:m1.TWV")
    field(INPC, "kohzu:m1.MRES")
    field(INPD, "kohzu:m1.HLM")
    field(INPE, "kohzu:m1.LLM")
    field(OUT, "kohzu:m1.TWV")
}
record(calcout, "kohzu:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "kohzu:m1.S")
    field(INPC, "kohzu:m1.SBAS")
    field(INPD, "kohzu:m1.SMAX")
    field(OUT, "kohzu:m1.S")
}
record(longout, "kohzu:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "kohzu:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
