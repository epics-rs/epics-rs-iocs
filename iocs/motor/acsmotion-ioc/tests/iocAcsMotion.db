    field(DESC, "Safe Torque Off")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(ACS1,0)SPIIPLUS_SAFE_TORQUE_OFF")
    field(ONAM, "Fault")
    field(SCAN, "I/O Intr")
    field(ZNAM, "OK")
}
record(ao, "acsMotion:m1:homingCurrLimit") {
    field(DESC, "Homing Current Limit")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn(ACS1,0)SPIIPLUS_HOMING_CURR_LIMIT")
    field(PINI, "YES")
