# c-expansion of st.cmd over the C sources, the records of iocAcsMotion.dbl:
# dbl of motor R7-4-5 motorAcsMotion iocBoot/iocAcsMotion st.cmd. cbMAcsMotion
# links no busy record, so its records come from it with the
# profileMoveController.template block cut from AcsMotion.substitutions, and
# that block's from oracleBusyIoc loading the template with the block's macros.
record(bi, "acsMotion:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "acsMotion:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "acsMotion:alldone")
    field(INPB, "acsMotion:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "acsMotion:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(asyn, "acsMotion:asyn") {
    field(ADDR, "0")
    field(DTYP, "asynRecordDevice")
    field(IMAX, "256")
    field(OMAX, "256")
    field(PORT, "ACS1_ETH")
}
record(asyn, "acsMotion:io:asyn") {
    field(ADDR, "0")
    field(DTYP, "asynRecordDevice")
    field(IMAX, "256")
    field(OMAX, "256")
    field(PORT, "ACS1_IO_ETH")
}
record(motor, "acsMotion:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "10")
    field(DIR, "Pos")
    field(DLLM, "-10")
    field(DTYP, "asynMotor")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, "1.240234375e-05")
    field(OUT, "@asyn(ACS1,0)")
    field(PREC, "6")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "acsMotion:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bi, "acsMotion:m1:HOMED") {
    field(DESC, "Homing Procedure Done")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(ACS1,0)SPIIPLUS_HOMING_DONE")
    field(ONAM, "True")
    field(SCAN, "I/O Intr")
    field(ZNAM, "False")
}
record(longin, "acsMotion:m1:MFLAGS") {
    field(DESC, "MFLAGS parameter")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(ACS1,0)SPIIPLUS_MFLAGS")
    field(SCAN, "I/O Intr")
}
record(longin, "acsMotion:m1:MFLAGSX") {
