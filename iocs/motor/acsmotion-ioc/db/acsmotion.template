# ACS SPiiPlus: one motor record per axis, ADDR the 0-based axis of controller
# PORT as in C's basic_asyn_motor.db.
#
# The driver scales the record's steps by the axis STEPF/EFAC into the
# controller's user units (typically mm), as C; MRES is the C example's m1 row
# (AcsMotion.substitutions).

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=10)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=100)")
    field(DLLM, "$(LLM=-100)")
    field(MRES, "$(MRES=1.240234375e-05)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
