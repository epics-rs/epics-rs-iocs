# Simulated motor: one motor record per axis, ADDR the axis of controller
# PORT as in C's basic_asyn_motor.db. The simulator is
# unitless — positions and velocities are dimensionless record EGU, so EGU is
# arbitrary. MRES is the record's step (RRBV is an integer count); the default
# is the C example's (motorSim.substitutions). VELO/ACCL map straight onto the
# trajectory's Vmax/Amax.

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=5.0)")
    field(ACCL, "$(ACCL=0.5)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=-100.0)")
    field(MRES, "$(MRES=0.01)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
