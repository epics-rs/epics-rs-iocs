# c-expansion of st.cmd over the C sources, the records of motorSim.dbl:
# dbl of motor R7-4-5 motorMotorSim iocBoot/iocMotorSim st.cmd
record(motor, "IOC:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "asynMotor")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "@asyn(motorSim1,0)")
    field(PREC, "5")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(longout, "IOC:m1Direction") {
    field(DESC, "m1 direction")
    field(DOL, "IOC:m1.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(motorSim1,0)MOTOR_REC_DIRECTION")
}
record(ao, "IOC:m1Offset") {
    field(DESC, "m1 offset")
    field(DOL, "IOC:m1.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(motorSim1,0)MOTOR_REC_OFFSET")
    field(PREC, "5")
}
record(ao, "IOC:m1Resolution") {
    field(DESC, "m1 resolution")
    field(DOL, "IOC:m1.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(motorSim1,0)MOTOR_REC_RESOLUTION")
    field(PREC, "5")
}
