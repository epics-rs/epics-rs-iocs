# c-expansion of st.cmd.CONEX-PP over the C sources, the records of iocNewport.CONEX-PP.dbl:
# dbl of motor R7-4-5 motorNewport iocBoot/iocNewport st.cmd.CONEX-PP
record(motor, "IOC:m1") {
    field(ACCL, ".25")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "X")
    field(DHLM, "28")
    field(DIR, "Pos")
    field(DLLM, "-1")
    field(DTYP, "asynMotor")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, "4.9609375e-5")
    field(NTM, "0")
    field(OUT, "@asyn(CONEX1,0)")
    field(PREC, "4")
    field(RTRY, "0")
    field(TWV, "1")
    field(VBAS, "0.1")
    field(VELO, "1.")
}
record(longout, "IOC:m1Direction") {
    field(DESC, "m1 direction")
    field(DOL, "IOC:m1.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(CONEX1,0)MOTOR_REC_DIRECTION")
}
record(ao, "IOC:m1Offset") {
    field(DESC, "m1 offset")
    field(DOL, "IOC:m1.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(CONEX1,0)MOTOR_REC_OFFSET")
    field(PREC, "4")
}
record(ao, "IOC:m1Resolution") {
    field(DESC, "m1 resolution")
    field(DOL, "IOC:m1.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(CONEX1,0)MOTOR_REC_RESOLUTION")
    field(PREC, "4")
}
