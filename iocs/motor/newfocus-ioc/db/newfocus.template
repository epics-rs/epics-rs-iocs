# Newport New Focus PMNC 8750/8752: one motor record per discovered channel,
# signal S of card C as in C's basic_motor.db; the driver maps the signal onto
# the discovered (driver module, channel).
# Values from C's PMNC87xx.substitutions. The driver clamps velocity to
# 2000 steps/sec and acceleration to 16..32000 steps/sec^2.

record(motor, "$(P)$(M)") {
    field(DTYP, "PMNC87xx")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1)")
    field(VBAS, "$(VBAS=0.1)")
    field(ACCL, "$(ACCL=0.2)")
    field(BDST, "$(BDST=0)")
    field(BVEL, "$(BVEL=1)")
    field(BACC, "$(BACC=0.2)")
    field(DHLM, "$(HLM=100)")
    field(DLLM, "$(LLM=-100)")
    field(MRES, "$(MRES=2.5e-4)")
    field(EGU,  "$(EGU=degrees)")
    field(PREC, "$(PREC=5)")
}
