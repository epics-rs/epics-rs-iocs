# C's iocNewFocus PMNC87xx.substitutions on this IOC's axis, P from st.cmd;
# the values are the motor record this IOC had before. The driver maps
# signal S onto the discovered (driver module, channel) and clamps velocity
# to 2000 steps/sec and acceleration to 16..32000 steps/sec^2.
file "$(MOTOR)/db/motor.db"
{
pattern
{N,  M,        DTYP,        C,  S,  DESC,  EGU,      DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,    PREC,  DHLM,  DLLM,  INIT}
{1,  "m$(N)",  "PMNC87xx",  0,  0,  "",    degrees,  Pos,  1,     .1,    .2,    0,     1,     .2,    2.5e-4,  5,     100,   -100,  ""}
}
