# c-expansion of st.cmd over the C sources, the records of st.cmd.dbl:
# dbl of motor R7-4-5 motorNewFocus iocBoot/iocNewFocus st.cmd
# C refuses newfocus8742.cmd:23 (from st.cmd): asyn_motor.db, which does not parse
# C refuses newfocus8742.cmd:25 (from st.cmd): asynRecord.db, which does not parse
record(bi, "newFocus:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "newFocus:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "newFocus:alldone")
    field(INPB, "newFocus:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "newFocus:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "newFocus:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "PMNC87xx")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "2.5e-4")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "newFocus:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "newFocus:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "newFocus:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "newFocus:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "newFocus:m1.TWV")
    field(INPC, "newFocus:m1.MRES")
    field(INPD, "newFocus:m1.HLM")
    field(INPE, "newFocus:m1.LLM")
    field(OUT, "newFocus:m1.TWV")
}
record(calcout, "newFocus:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "newFocus:m1.S")
    field(INPC, "newFocus:m1.SBAS")
    field(INPD, "newFocus:m1.SMAX")
    field(OUT, "newFocus:m1.S")
}
