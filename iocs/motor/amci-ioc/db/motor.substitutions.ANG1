# C's iocAMCI motor.substitutions.ANG1, P from st.ang1.cmd. C's file loads
# $(MOTOR)/motorApp/Db/basic_asyn_motor.db, a source-tree path, and then
# $(MOTOR)/motorApp/Db/ANG1Aux.template, which no motor or motorAMCI release
# has; the ANG1 has no aux records here.
file "$(MOTOR)/db/basic_asyn_motor.db"
{
pattern
{N,   M,       DTYP,        PORT,       ADDR, DESC,          EGU,   DIR, VELO, VBAS, ACCL, BDST, BVEL, BACC, MRES, PREC, DHLM, DLLM, INIT}
{101, "m$(N)", "asynMotor", "ANG1_1_1", 0,    "AMCI ANG1 1", steps, Pos, 100,  0,    .2,   0,    50,   .2,   1,    5,    1e9,  -1e9, ""}
{102, "m$(N)", "asynMotor", "ANG1_1_2", 0,    "AMCI ANG1 2", steps, Pos, 100,  0,    .2,   0,    50,   .2,   1,    5,    1e9,  -1e9, ""}
}
