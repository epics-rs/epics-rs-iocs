# c-expansion of st.cmd over the C sources, its controller calls:
modbusInterposeConfig("ANF2_C1_IP", 0, 2000, 0)
modbusInterposeConfig("ANF2_C2_IP", 0, 2000, 0)
drvModbusAsynConfigure("ANF2_C1_In", "ANF2_C1_IP", 0, 4, 0, 120, 0, 100, "ANF2_stepper")
drvModbusAsynConfigure("ANF2_C2_In", "ANF2_C2_IP", 0, 4, 0, 60, 0, 100, "ANF2_stepper")
drvModbusAsynConfigure("ANF2_C1_Out", "ANF2_C1_IP", 0, 16, 1024, 120, 6, 1, "ANF2_stepper")
drvModbusAsynConfigure("ANF2_C2_Out", "ANF2_C2_IP", 0, 16, 1024, 60, 6, 1, "ANF2_stepper")
ANF2CreateController("ANF2_C1", "ANF2_C1_In", "ANF2_C1_Out", 12)
ANF2CreateAxis("ANF2_C1", 0, 0x86280000, 100, 0)
ANF2CreateAxis("ANF2_C1", 1, 0x86000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 2, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 3, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 4, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 5, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 6, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 7, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 8, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 9, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 10, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C1", 11, 0x84000000, 100, 0)
ANF2CreateController("ANF2_C2", "ANF2_C2_In", "ANF2_C2_Out", 6)
ANF2CreateAxis("ANF2_C2", 0, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C2", 1, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C2", 2, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C2", 3, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C2", 4, 0x84000000, 100, 0)
ANF2CreateAxis("ANF2_C2", 5, 0x84000000, 100, 0)
ANF2StartPoller("ANF2_C1", 200, 1000)
ANF2StartPoller("ANF2_C2", 200, 1000)
