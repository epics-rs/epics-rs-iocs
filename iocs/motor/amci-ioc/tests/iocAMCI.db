record(longout, "amci:m10Direction") {
    field(DESC, "m10 direction")
    field(DOL, "amci:m10.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(ANF2_C1,9)MOTOR_REC_DIRECTION")
}
record(ao, "amci:m10Offset") {
    field(DESC, "m10 offset")
    field(DOL, "amci:m10.OFF CP MS")
