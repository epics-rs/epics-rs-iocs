    field(PINI, "0")
    field(VAL, "0")
}
record(bo, "amci:m10:ResetErrors") {
    field(DESC, "Reset Errors")
    field(DTYP, "asynInt32")
    field(ONAM, "Reset")
    field(OUT, "@asyn(ANF2_C1,9)ANF2_RESET_ERRORS")
    field(PINI, "0")
    field(VAL, "0")
    field(ZNAM, "Done")
