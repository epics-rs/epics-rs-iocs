    field(DOL, "amci:m5.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(ANF2_C1,4)MOTOR_REC_RESOLUTION")
    field(PREC, "5")
}
record(bo, "amci:m5_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "amci:m5.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "amci:m5_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "amci:m5.TWV")
    field(INPC, "amci:m5.MRES")
    field(INPD, "amci:m5.HLM")
    field(INPE, "amci:m5.LLM")
    field(OUT, "amci:m5.TWV")
}
record(calcout, "amci:m5_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "amci:m5.S")
    field(INPC, "amci:m5.SBAS")
    field(INPD, "amci:m5.SMAX")
    field(OUT, "amci:m5.S")
}
record(motor, "amci:m6") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "50")
    field(DESC, "ANF2 C1 M6")
    field(DHLM, "1e9")
    field(DIR, "Pos")
    field(DLLM, "-1e9")
    field(DTYP, "asynMotor")
    field(EGU, "steps")
    field(INIT, "")
    field(MRES, "1")
    field(OUT, "@asyn(ANF2_C1,5)")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "amci:m6_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "100")
}
record(bo, "amci:m6:GetInfo") {
    field(DESC, "Get Info")
    field(DTYP, "asynInt32")
    field(OUT, "@asyn(ANF2_C1,5)ANF2_GET_INFO")
    field(PINI, "0")
    field(VAL, "0")
}
record(bo, "amci:m6:ResetErrors") {
    field(DESC, "Reset Errors")
    field(DTYP, "asynInt32")
    field(ONAM, "Reset")
    field(OUT, "@asyn(ANF2_C1,5)ANF2_RESET_ERRORS")
    field(PINI, "0")
    field(VAL, "0")
    field(ZNAM, "Done")
}
record(longout, "amci:m6Direction") {
    field(DESC, "m6 direction")
    field(DOL, "amci:m6.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(ANF2_C1,5)MOTOR_REC_DIRECTION")
