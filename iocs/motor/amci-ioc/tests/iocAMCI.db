    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "amci:m10.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "amci:m10_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "amci:m10.TWV")
    field(INPC, "amci:m10.MRES")
    field(INPD, "amci:m10.HLM")
    field(INPE, "amci:m10.LLM")
    field(OUT, "amci:m10.TWV")
}
