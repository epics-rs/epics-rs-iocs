# c-expansion of st.cmd over the C sources, the records of iocAMCI.dbl:
# dbl of motor R7-4-5 motorAMCI iocBoot/iocAMCI st.cmd
record(bi, "amci:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "amci:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "amci:alldone")
    field(INPB, "amci:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "amci:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "amci:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "50")
    field(DESC, "ANF2 C1 M1")
    field(DHLM, "1e9")
    field(DIR, "Pos")
    field(DLLM, "-1e9")
    field(DTYP, "asynMotor")
    field(EGU, "steps")
    field(INIT, "")
    field(MRES, "1")
    field(OUT, "@asyn(ANF2_C1,0)")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "amci:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "100")
}
record(motor, "amci:m10") {
