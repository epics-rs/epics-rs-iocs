# C's iocNPoint C300.substitutions, P and PORT from st.cmd; the values are
# the motor record this IOC had before. Positions cross the driver boundary
# in the controller's native units, so MRES = 1.
file "$(MOTOR)/db/asyn_motor.db"
{
pattern
{N,  M,       DTYP,         ADDR,  DESC,  EGU,     DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,    DLLM,     INIT}
{1,  "m$(N)", "asynMotor",  0,     "",    counts,  Pos,  1,     0,     .2,    0,     0,     .5,    1,     0,     524288,  -524288,  ""}
{2,  "m$(N)", "asynMotor",  1,     "",    counts,  Pos,  1,     0,     .2,    0,     0,     .5,    1,     0,     524288,  -524288,  ""}
{3,  "m$(N)", "asynMotor",  2,     "",    counts,  Pos,  1,     0,     .2,    0,     0,     .5,    1,     0,     524288,  -524288,  ""}
}
