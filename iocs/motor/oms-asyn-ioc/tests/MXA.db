# c-expansion of st.cmd, MXA.cmd, no MAXnet.cmd, no MAXv.cmd over the C sources, the records of MXA.dbl:
# dbl of motor R7-4-5 motorOmsAsyn iocBoot/iocOmsAsyn st.cmd with < MXA.cmd
record(bi, "omsAsyn:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "omsAsyn:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "omsAsyn:alldone")
    field(INPB, "omsAsyn:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "omsAsyn:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "omsAsyn:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, "2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "0")
    field(DIR, "Pos")
    field(DLLM, "0")
    field(DTYP, "asynMotor")
    field(EGU, "deg")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "@asyn(MXA1,0)")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "omsAsyn:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "10")
}
record(bo, "omsAsyn:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "omsAsyn:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "omsAsyn:m1_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "omsAsyn:m1.TWV")
    field(INPC, "omsAsyn:m1.MRES")
    field(INPD, "omsAsyn:m1.HLM")
    field(INPE, "omsAsyn:m1.LLM")
    field(OUT, "omsAsyn:m1.TWV")
}
record(calcout, "omsAsyn:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "omsAsyn:m1.S")
    field(INPC, "omsAsyn:m1.SBAS")
    field(INPD, "omsAsyn:m1.SMAX")
    field(OUT, "omsAsyn:m1.S")
}
