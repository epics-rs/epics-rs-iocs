# c-expansion of st.cmd over the C sources, the records of iocOmsAsyn.dbl:
# dbl of motor R7-4-5 motorOmsAsyn iocBoot/iocOmsAsyn st.cmd
record(bi, "omsAsyn:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "omsAsyn:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "omsAsyn:alldone")
    field(INPB, "omsAsyn:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "omsAsyn:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "omsAsyn:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, "2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "0")
    field(DIR, "Pos")
    field(DLLM, "0")
    field(DTYP, "asynMotor")
    field(EGU, "deg")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "@asyn(MAXv0,0)")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "omsAsyn:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "10")
}
record(longout, "omsAsyn:m1Direction") {
    field(DESC, "m1 direction")
    field(DOL, "omsAsyn:m1.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MAXv0,0)MOTOR_REC_DIRECTION")
}
record(ao, "omsAsyn:m1Offset") {
    field(DESC, "m1 offset")
    field(DOL, "omsAsyn:m1.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MAXv0,0)MOTOR_REC_OFFSET")
    field(PREC, "5")
}
record(ao, "omsAsyn:m1Resolution") {
    field(DESC, "m1 resolution")
    field(DOL, "omsAsyn:m1.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MAXv0,0)MOTOR_REC_RESOLUTION")
    field(PREC, "5")
}
record(bo, "omsAsyn:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "omsAsyn:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "omsAsyn:m1_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "omsAsyn:m1.TWV")
    field(INPC, "omsAsyn:m1.MRES")
    field(INPD, "omsAsyn:m1.HLM")
    field(INPE, "omsAsyn:m1.LLM")
    field(OUT, "omsAsyn:m1.TWV")
}
record(calcout, "omsAsyn:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "omsAsyn:m1.S")
    field(INPC, "omsAsyn:m1.SBAS")
    field(INPD, "omsAsyn:m1.SMAX")
    field(OUT, "omsAsyn:m1.S")
}
record(motor, "omsAsyn:m2") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, "2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 2")
    field(DHLM, "0")
    field(DIR, "Pos")
    field(DLLM, "0")
    field(DTYP, "asynMotor")
    field(EGU, "deg")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "@asyn(MAXNET,0)")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "omsAsyn:m2_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "10")
}
record(longout, "omsAsyn:m2Direction") {
    field(DESC, "m2 direction")
    field(DOL, "omsAsyn:m2.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MAXNET,0)MOTOR_REC_DIRECTION")
}
record(ao, "omsAsyn:m2Offset") {
    field(DESC, "m2 offset")
    field(DOL, "omsAsyn:m2.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MAXNET,0)MOTOR_REC_OFFSET")
    field(PREC, "5")
}
record(ao, "omsAsyn:m2Resolution") {
    field(DESC, "m2 resolution")
    field(DOL, "omsAsyn:m2.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(MAXNET,0)MOTOR_REC_RESOLUTION")
    field(PREC, "5")
}
record(bo, "omsAsyn:m2_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "omsAsyn:m2.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "omsAsyn:m2_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "omsAsyn:m2.TWV")
    field(INPC, "omsAsyn:m2.MRES")
    field(INPD, "omsAsyn:m2.HLM")
    field(INPE, "omsAsyn:m2.LLM")
    field(OUT, "omsAsyn:m2.TWV")
}
record(calcout, "omsAsyn:m2_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "omsAsyn:m2.S")
    field(INPC, "omsAsyn:m2.SBAS")
    field(INPD, "omsAsyn:m2.SMAX")
    field(OUT, "omsAsyn:m2.S")
}
record(longout, "omsAsyn:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "omsAsyn:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
