# C's iocNewport PM500.substitutions on this IOC's one axis, P from st.cmd;
# the values are the motor record this IOC had before. Signal 0,1,2,... is
# controller channel X,Y,Z,A,... The driver boundary is raw steps of 0.01
# controller units (microns or arc-sec), C's drive_resolution, so MRES must
# be 0.01 in those units. C's MRES is 5e-5 mm, which reads every position
# back at five times the stage's.
file "$(MOTOR)/db/motor.db"
{
pattern
{N,  M,       DTYP,     C,  S,  DESC,  EGU,  DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,   DLLM,    INIT}
{1,  "m$(N)", "PM500",  0,  0,  "",    um,   Pos,  100,   0,     .5,    0,     1,     .2,    0.01,  3,     10000,  -10000,  ""}
}
