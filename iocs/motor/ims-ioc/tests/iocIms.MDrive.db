# c-expansion of st.cmd, MDrive.cmd for MDrive-Eth.cmd over the C sources, the records of iocIms.MDrive.dbl:
# dbl of motor R7-4-5 motorIms iocBoot/iocIms st.cmd running MDrive.cmd for MDrive-Eth.cmd
record(bi, "ims:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "ims:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "ims:alldone")
    field(INPB, "ims:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "ims:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "ims:m3") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 3")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "MDrive")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "ims:m3_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "ims:m3_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "ims:m3.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "ims:m3_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "ims:m3.TWV")
    field(INPC, "ims:m3.MRES")
    field(INPD, "ims:m3.HLM")
    field(INPE, "ims:m3.LLM")
    field(OUT, "ims:m3.TWV")
}
record(calcout, "ims:m3_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "ims:m3.S")
    field(INPC, "ims:m3.SBAS")
    field(INPD, "ims:m3.SMAX")
    field(OUT, "ims:m3.S")
}
record(longout, "ims:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "ims:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
