# Micronix MMC-100/200: one motor record per axis. Load once per axis with
# ADDR = 0-based axis index of port PORT; the driver maps index
# 0,1,2,... to controller axes 1,2,3,...
# The driver scales the record's steps by the axis resolution read from the
# controller (FBK?/REZ?/UST?/ENC?), as C; MRES equal to it gives EGU in the
# controller's mm or deg.

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=3.0)")
    field(ACCL, "$(ACCL=0.5)")
    field(DHLM, "$(HLM=10.0)")
    field(DLLM, "$(LLM=-10.0)")
    field(MRES, "$(MRES=2.44140625e-6)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=5)")
}
