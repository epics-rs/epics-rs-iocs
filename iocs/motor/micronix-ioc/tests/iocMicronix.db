    field(DESC, "change velocity")
    field(INPB, "micronix:m2.S")
    field(INPC, "micronix:m2.SBAS")
    field(INPD, "micronix:m2.SMAX")
    field(OUT, "micronix:m2.S")
}
record(longout, "micronix:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "micronix:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
