    field(DOL, "micronix:m2.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(mmc200_1,1)MOTOR_REC_RESOLUTION")
    field(PREC, "5")
}
record(bo, "micronix:m2_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "micronix:m2.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "micronix:m2_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "micronix:m2.TWV")
    field(INPC, "micronix:m2.MRES")
    field(INPD, "micronix:m2.HLM")
    field(INPE, "micronix:m2.LLM")
    field(OUT, "micronix:m2.TWV")
