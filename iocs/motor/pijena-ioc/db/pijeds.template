# piezosystem jena E-516 (PIJEDS): one motor record per axis. Load once per
# axis with S = 0-based signal (DTYP "PIJEDS", OUT #C$(C) S$(S)); the driver maps
# index 0,1,2,... to controller axes 0,1,2,...
#
# The E-516 is a CLOSED-LOOP capacitive-feedback piezo positioner. The driver
# scales the record's steps by drive_resolution (1e-3 um) into um, as C; MRES
# defaults to drive_resolution so EGU is um. Motion
# completion is inferred from the feedback position settling. Homing and
# hardware limit switches are not supported; VELO maps to the controller's slew
# rate.

record(motor, "$(P)$(M)") {
    field(DTYP, "PIJEDS")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=10.0)")
    field(ACCL, "$(ACCL=0.5)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=0.0)")
    field(MRES, "$(MRES=1.0e-3)")
    field(EGU,  "$(EGU=um)")
    field(PREC, "$(PREC=3)")
}
