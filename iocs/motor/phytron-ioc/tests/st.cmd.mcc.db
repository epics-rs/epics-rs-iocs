# dbl of motor R7-4-5 motorPhytron iocBoot/iocPhytron st.cmd.mcc
record(motor, "TEST:m1") {
    field(ACCL, ".5")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "180")
    field(DESC, "motor 1")
    field(DHLM, "1440")
    field(DIR, "Pos")
    field(DLLM, "-1440")
    field(DTYP, "asynMotor")
    field(EGU, "Deg")
    field(ERES, "0.00005")
    field(INIT, "")
    field(MDEL, "0.001")
    field(MRES, "0")
    field(OFF, "-0.49")
    field(OUT, "@asyn(phyMotionPort,11)")
    field(PREC, "5")
    field(RDBD, "0")
    field(RTRY, "0")
    field(SREV, "400")
    field(TWV, "1")
    field(UEIP, "No")
    field(UREV, "0.25")
    field(VBAS, "180")
    field(VELO, "360")
    field(VMAX, "720")
}
