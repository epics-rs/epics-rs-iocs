# c-expansion of st.cmd.phytron, phymotion.substitutions for motor.substitutions.phytron over the C sources, the records of st.cmd.phytron.dbl:
# dbl of motor R7-4-5 motorPhytron iocBoot/iocPhytron st.cmd.phytron, its
# motor.substitutions.phytron's phyMOTION blocks and four Phytron_AIO.db
# channels in place of the MCC-2 ones
record(motor, "TEST:m1") {
    field(ACCL, ".5")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "25")
    field(DESC, "motor 1")
    field(DHLM, "1440")
    field(DIR, "Pos")
    field(DLLM, "-1440")
    field(DTYP, "asynMotor")
    field(EGU, "mm")
    field(ERES, "0.00005")
    field(INIT, "")
    field(MDEL, "0.001")
    field(MRES, "0.000625")
    field(OFF, "-0.49")
    field(OUT, "@asyn(phyMotionPort,11)")
    field(PREC, "5")
    field(RDBD, "0")
    field(RTRY, "0")
    field(SREV, "0")
    field(TWV, "1")
    field(UEIP, "No")
    field(UREV, "0")
    field(VBAS, "1")
    field(VELO, "2.5")
    field(VMAX, "25")
}
