# C's iocThorLabs MDT695.substitutions, P and C from st.cmd. Signal 0,1,2 is
# channel X,Y,Z; the controller is open-loop voltage control, and the driver
# scales the record's steps by C's drive_resolution, 0.1 V.
file "$(MOTOR)/db/motor.db"
{
pattern
{N,  M,        DTYP,      S,  DESC,          EGU,      DIR,  VELO,  VBAS,  ACCL,  BDST,  BVEL,  BACC,  MRES,  PREC,  DHLM,  DLLM,  INIT}
{1,  "m$(N)",  "MDT695",  0,  "motor $(N)",  degrees,  Pos,  1,     .1,    .2,    0,     1,     .2,    0.01,  5,     100,   -100,  ""}
}
