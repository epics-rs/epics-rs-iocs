# Micos SMC Taurus: one motor record per axis. Load once per axis with N =
# 0-based axis index (DTYP TAURUS_$(CARD)_$(N)); the command prefix uses N + 1.
#
# The driver reports positions in controller-native engineering units. MRES is
# the record's step (RRBV is an integer count and RDBD >= MRES), so set it to
# the controller's "<n> getclperiod" reply: C uses that as axisRes and scales
# wire = steps * axisRes, so its EGU is the controller unit only at
# MRES = clPeriod. motorMicos ships no Taurus example, so the 0.0001 default is
# a placeholder, not a C value. Changing DHLM/DLLM pushes the soft limits to the
# controller (setnlimit).

record(motor, "$(P)$(M)") {
    field(DTYP, "TAURUS_$(CARD)_$(N)")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=5.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=-100.0)")
    field(MRES, "$(MRES=0.0001)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
