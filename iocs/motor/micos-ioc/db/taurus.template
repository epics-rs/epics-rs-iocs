# Micos SMC Taurus: one motor record per axis. Load once per axis with ADDR =
# 0-based axis index of port PORT; the command prefix uses ADDR + 1.
#
# The driver reports positions in controller-native engineering units. MRES is
# the record's step (RRBV is an integer count and RDBD >= MRES). motorMicos
# ships no Taurus example; the default is the corvus example's mm step
# (motor.substitutions.SMCcorvus). Changing DHLM/DLLM pushes the soft limits to
# the controller (setnlimit).

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=5.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=-100.0)")
    field(MRES, "$(MRES=5e-3)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
