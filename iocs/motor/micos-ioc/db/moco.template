# drvMicos.cc's model-1 MoCo dc: one motor record per MoCo driver, address S
# on the serial line of card C, as in C's basic_motor.db.
#
# The MoCo takes positions and speeds in raw steps, so MRES = 1 and
# EGU = steps.

record(motor, "$(P)$(M)") {
    field(DTYP, "Micos MoCo")
    field(OUT,  "#C$(C) S$(S) @")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1000.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=1000000.0)")
    field(DLLM, "$(LLM=-1000000.0)")
    field(MRES, "$(MRES=1.0)")
    field(EGU,  "$(EGU=steps)")
    field(PREC, "$(PREC=0)")
}
