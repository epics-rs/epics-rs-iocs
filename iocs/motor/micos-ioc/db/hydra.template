# Micos SMC hydra: one motor record per axis. Load once per axis with ADDR =
# 0-based axis index of port PORT; the command prefix uses ADDR + 1.
#
# The driver reports positions in controller-native engineering units. MRES is
# the record's step (RRBV is an integer count and RDBD >= MRES), so set it to
# the axis resolution, C's axisRes = pitch/(4*polePairs) or clPeriod; the
# default is the C example's (motor.substitutions.SMChydra).

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=5.0)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=100.0)")
    field(DLLM, "$(LLM=-100.0)")
    field(MRES, "$(MRES=0.01)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
