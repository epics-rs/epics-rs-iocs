# c-expansion of st.cmd, no motor.cmd.SMCcorvus, no motor.cmd.SMChydra over the C sources, the records of iocMicos.moco.dbl:
# dbl of motor R7-4-5 motorMicos iocBoot/iocMicos st.cmd with MoCo.cmd alone
record(bi, "micos:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "micos:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "micos:alldone")
    field(INPB, "micos:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "micos:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "micos:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "Micos MoCo")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "#C0 S0 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "micos:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "micos:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "micos:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "micos:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "micos:m1.TWV")
    field(INPC, "micos:m1.MRES")
    field(INPD, "micos:m1.HLM")
    field(INPE, "micos:m1.LLM")
    field(OUT, "micos:m1.TWV")
}
record(calcout, "micos:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "micos:m1.S")
    field(INPC, "micos:m1.SBAS")
    field(INPD, "micos:m1.SMAX")
    field(OUT, "micos:m1.S")
}
record(motor, "micos:m2") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 2")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "Micos MoCo")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "0.01")
    field(OUT, "#C0 S1 @")
    field(PREC, "5")
    field(RSTM, "NearZero")
    field(SDIS, "micos:m2_able.VAL")
    field(TWV, "1")
    field(VBAS, ".1")
    field(VELO, "1")
}
record(bo, "micos:m2_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "micos:m2.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "micos:m2_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "micos:m2.TWV")
    field(INPC, "micos:m2.MRES")
    field(INPD, "micos:m2.HLM")
    field(INPE, "micos:m2.LLM")
    field(OUT, "micos:m2.TWV")
}
record(calcout, "micos:m2_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "micos:m2.S")
    field(INPC, "micos:m2.SBAS")
    field(INPD, "micos:m2.SMAX")
    field(OUT, "micos:m2.S")
}
record(longout, "micos:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "micos:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
