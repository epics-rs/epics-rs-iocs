# c-expansion of st.cmd over the C sources, the records of iocMclennan.dbl:
# dbl of motor R7-4-5 motorMclennan iocBoot/iocMclennan st.cmd
record(bi, "mclennan:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "mclennan:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "mclennan:alldone")
    field(INPB, "mclennan:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "mclennan:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "mclennan:m1") {
    field(ACCL, "1.")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "motor 1")
    field(DHLM, "100")
    field(DIR, "Pos")
    field(DLLM, "-100")
    field(DTYP, "Mclennan PM304")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, "1e-3")
    field(OUT, "#C0 S0 @")
    field(PREC, "3")
    field(RSTM, "NearZero")
    field(SDIS, "mclennan:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0.")
    field(VELO, "10")
}
record(bo, "mclennan:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "mclennan:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "mclennan:m1_twCh") {
    field(CALC, "min(max(a*b,abs(c)),d-e)")
    field(DESC, "change TWV")
    field(INPB, "mclennan:m1.TWV")
    field(INPC, "mclennan:m1.MRES")
    field(INPD, "mclennan:m1.HLM")
    field(INPE, "mclennan:m1.LLM")
    field(OUT, "mclennan:m1.TWV")
}
record(calcout, "mclennan:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "mclennan:m1.S")
    field(INPC, "mclennan:m1.SBAS")
    field(INPD, "mclennan:m1.SMAX")
    field(OUT, "mclennan:m1.S")
}
record(longout, "mclennan:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "mclennan:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
