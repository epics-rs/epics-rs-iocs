    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "Vertical")
    field(DHLM, "3")
    field(DIR, "Pos")
    field(DLLM, "-3")
    field(DTYP, "asynMotor")
    field(EGU, "mm")
    field(INIT, "")
    field(MRES, ".001")
    field(OUT, "@asyn(Agilis1,1)")
    field(PREC, "3")
    field(TWV, "1")
    field(VBAS, "0.1")
    field(VELO, ".5")
}
