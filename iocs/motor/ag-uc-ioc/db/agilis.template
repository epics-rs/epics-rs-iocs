# Newport Agilis AG-UC: one motor record per axis. Values from
# motor.substitutions.AG_UC: the driver sends record steps, so VELO/MRES
# picks C's jog and home speed code (500 steps/s → 4).

record(motor, "$(P)$(M0)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),0)")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=0.5)")
    field(VBAS, "$(VBAS=0.1)")
    field(ACCL, "$(ACCL=0.25)")
    field(DHLM, "$(HLM=3)")
    field(DLLM, "$(LLM=-3)")
    field(MRES, "$(MRES=0.001)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=3)")
    field(BDST, "$(BDST=0)")
    field(BVEL, "$(BVEL=1)")
    field(BACC, "$(BACC=0.2)")
}

record(motor, "$(P)$(M1)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),1)")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=0.5)")
    field(VBAS, "$(VBAS=0.1)")
    field(ACCL, "$(ACCL=0.25)")
    field(DHLM, "$(HLM=3)")
    field(DLLM, "$(LLM=-3)")
    field(MRES, "$(MRES=0.001)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=3)")
    field(BDST, "$(BDST=0)")
    field(BVEL, "$(BVEL=1)")
    field(BACC, "$(BACC=0.2)")
}
