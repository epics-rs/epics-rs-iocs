# Newport XPS: one motor record per axis. The XPS is a closed-loop servo with
# an encoder, so RBV tracks the encoder position. Positions are in engineering
# units (mm/deg); pass stepsPerUnit=1 in XPSCreateAxis so positions travel the
# driver boundary in EGU unscaled. MRES is the record's step (RRBV is an
# integer count and RDBD >= MRES), so set it to the positioner resolution; the
# default is the C example's (motor.substitutions.xps, 1/20480 mm).

record(motor, "$(P)$(M0)") {
    field(DTYP, "XPS_$(PORT)_0")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=10.0)")
    field(ACCL, "$(ACCL=0.5)")
    field(DHLM, "$(HLM=100)")
    field(DLLM, "$(LLM=-100)")
    field(MRES, "$(MRES=0.000048828)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
