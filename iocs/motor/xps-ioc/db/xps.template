# Newport XPS: one motor record per axis. The XPS is a closed-loop servo with
# an encoder, so RBV tracks the encoder position. Positions are in engineering
# units (mm/deg) and positions cross the driver boundary in record steps, so
# MRES must be 1/stepsPerUnit of XPSCreateAxis; the default is the C
# example's (motor.substitutions.xps, 1/20480 mm).

record(motor, "$(P)$(M0)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR=0))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=10.0)")
    field(ACCL, "$(ACCL=0.5)")
    field(DHLM, "$(HLM=100)")
    field(DLLM, "$(LLM=-100)")
    field(MRES, "$(MRES=0.000048828)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
