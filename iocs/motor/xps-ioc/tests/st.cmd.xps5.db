record(mbbi, "IOC:Prof1:ExecuteState") {
    field(DESC, "Profile execute state")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(XPS1,0,1)PROFILE_EXECUTE_STATE")
    field(ONST, "Move start")
    field(ONSV, "MINOR")
    field(ONVL, "1")
    field(SCAN, "I/O Intr")
    field(THST, "Flyback")
    field(THSV, "MINOR")
    field(THVL, "3")
    field(TWST, "Executing")
    field(TWSV, "MINOR")
    field(TWVL, "2")
    field(ZRST, "Done")
    field(ZRSV, "NO_ALARM")
    field(ZRVL, "0")
}
record(mbbi, "IOC:Prof1:ExecuteStatus") {
    field(DESC, "Profile execute status")
    field(DTYP, "asynInt32")
    field(FRST, "Timeout")
    field(FRSV, "MAJOR")
    field(FRVL, "4")
    field(INP, "@asyn(XPS1,0,1)PROFILE_EXECUTE_STATUS")
    field(ONST, "Success")
    field(ONSV, "NO_ALARM")
    field(ONVL, "1")
    field(SCAN, "I/O Intr")
    field(THST, "Abort")
    field(THSV, "MAJOR")
    field(THVL, "3")
    field(TWST, "Failure")
    field(TWSV, "MAJOR")
    field(TWVL, "2")
    field(ZRST, "Undefined")
    field(ZRSV, "INVALID")
    field(ZRVL, "0")
}
