    field(DTYP, "asynFloat64")
    field(INP, "@asyn(XPS1,5)MOTOR_POSITION")
    field(PINI, "1")
    field(PREC, "4")
    field(SCAN, "I/O Intr")
}
record(ao, "IOC:m6Resolution") {
    field(DESC, "m6 resolution")
    field(DOL, "IOC:m6.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(XPS1,5)MOTOR_REC_RESOLUTION")
    field(PREC, "4")
}
record(ai, "IOC:m6XPS_STATUS") {
    field(DESC, "XPS Group Status")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(XPS1,5)XPS_STATUS")
    field(PINI, "1")
    field(PREC, "0")
    field(SCAN, "I/O Intr")
}
record(motor, "IOC:m7") {
    field(ACCL, ".5")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "Dummy1")
    field(DHLM, "190")
    field(DIR, "Neg")
    field(DLLM, "-190")
    field(DTYP, "asynMotor")
    field(EGU, "degrees")
    field(INIT, "")
    field(MRES, ".00025")
    field(OUT, "@asyn(XPS1,6)")
    field(PREC, "4")
    field(TWV, "1")
    field(VBAS, "0.1")
    field(VELO, "4.0")
}
