# c-expansion of st.cmd.xps5 over the C sources, the records of st.cmd.xps5.names:
# Records of motor R7-4-5 motorNewport iocBoot/iocNewport st.cmd.xps5, from
# msi over motor.substitutions.xps5 (the dbl oracle has no busy record).
record(bo, "IOC:Prof1:Abort") {
    field(DESC, "Abort profile motion")
    field(DTYP, "asynInt32")
    field(ONAM, "Abort")
    field(OUT, "@asyn(XPS1,0,1)PROFILE_ABORT")
    field(ZNAM, "Done")
}
record(ao, "IOC:Prof1:Acceleration") {
    field(DESC, "Profile Acceleration")
    field(DTYP, "asynFloat64")
    field(OUT, "@asyn(XPS1,0,1)PROFILE_ACCELERATION")
    field(PINI, "YES")
    field(PREC, "3")
    field(VAL, "0.5")
}
record(busy, "IOC:Prof1:Build") {
    field(DESC, "Build and check profile")
    field(DTYP, "asynInt32")
    field(ONAM, "Build")
    field(OUT, "@asyn(XPS1,0,1)PROFILE_BUILD")
    field(ZNAM, "Done")
}
record(waveform, "IOC:Prof1:BuildMessage") {
    field(DESC, "Profile build message")
    field(DTYP, "asynOctetRead")
    field(FTVL, "CHAR")
    field(INP, "@asyn(XPS1,0,1)PROFILE_BUILD_MESSAGE")
    field(NELM, "256")
    field(SCAN, "I/O Intr")
}
record(mbbi, "IOC:Prof1:BuildState") {
    field(DESC, "Profile build state")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(XPS1,0,1)PROFILE_BUILD_STATE")
    field(ONST, "Busy")
    field(ONSV, "MINOR")
    field(ONVL, "1")
    field(SCAN, "I/O Intr")
    field(ZRST, "Done")
    field(ZRSV, "NO_ALARM")
    field(ZRVL, "0")
}
record(mbbi, "IOC:Prof1:BuildStatus") {
    field(DESC, "Profile build status")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(XPS1,0,1)PROFILE_BUILD_STATUS")
    field(ONST, "Success")
    field(ONSV, "NO_ALARM")
    field(ONVL, "1")
    field(SCAN, "I/O Intr")
    field(TWST, "Failure")
    field(TWSV, "MAJOR")
    field(TWVL, "2")
    field(ZRST, "Undefined")
    field(ZRSV, "INVALID")
    field(ZRVL, "0")
}
record(longin, "IOC:Prof1:CurrentPoint") {
    field(DESC, "Current point in profile")
    field(DTYP, "asynInt32")
    field(INP, "@asyn(XPS1,0,1)PROFILE_CURRENT_POINT")
    field(SCAN, "I/O Intr")
}
record(longout, "IOC:Prof1:EndPulses") {
    field(DESC, "Point # to end pulses")
    field(DTYP, "asynInt32")
    field(OUT, "@asyn(XPS1,0,1)PROFILE_END_PULSES")
    field(PINI, "YES")
    field(VAL, "2000")
}
