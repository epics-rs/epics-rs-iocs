# Delta Tau PMAC coordinate-system (kinematic) axis ADDR of the port
# drvAsynMotorConfigure made over pmacAsynCoord (0=A 1=B 2=C 3=U 4=V 5=W 6=X
# 7=Y 8=Z).
#
# A CS axis is driven in record steps of stepSize EGU, the EGU the coordinate
# system's position-reporting PLC publishes on Q8n, so MRES must equal stepSize:
# the C default 1e-4 unless pmacSetCoordStepsPerUnit/pmacSetDefaultCoordSteps
# changes it (pmacAsynCoord.c).
#
# Homing and jogging are not defined for a kinematic axis: HOMF/HOMR/JOGF/JOGR
# return an error, as they do in the C driver.

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1)")
    field(ACCL, "$(ACCL=0.5)")
    field(DHLM, "$(HLM=100)")
    field(DLLM, "$(LLM=-100)")
    field(MRES, "$(MRES=0.0001)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
