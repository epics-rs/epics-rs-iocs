# c-expansion of st.cmd over the C sources, the records of iocPIGCS2.dbl:
# dbl of motor R7-4-5 motorPIGCS2 iocBoot/iocPIGCS2 st.cmd
record(bi, "pigcs2:alldone") {
    field(DESC, "All IOC motors done moving.")
    field(INP, "1")
    field(ONAM, "done")
    field(ZNAM, "moving")
}
record(calc, "pigcs2:alldoneBlink") {
    field(CALC, "A?0:!B")
    field(INPA, "pigcs2:alldone")
    field(INPB, "pigcs2:alldoneBlink")
    field(SCAN, ".5 second")
}
record(bo, "pigcs2:allstop") {
    field(DESC, "Stop All IOC motors.")
    field(ONAM, "stop")
    field(ZNAM, "release")
}
record(motor, "pigcs2:m1") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "Motor 1")
    field(DHLM, "0.0")
    field(DIR, "Pos")
    field(DLLM, "0.0")
    field(DTYP, "asynMotor")
    field(EGU, "deg")
    field(INIT, "")
    field(MRES, "0.0005")
    field(OUT, "@asyn(C867,0)")
    field(PREC, "4")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "pigcs2:m1_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "5")
}
record(longout, "pigcs2:m1Direction") {
    field(DESC, "m1 direction")
    field(DOL, "pigcs2:m1.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(C867,0)MOTOR_REC_DIRECTION")
}
record(ao, "pigcs2:m1Offset") {
    field(DESC, "m1 offset")
    field(DOL, "pigcs2:m1.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(C867,0)MOTOR_REC_OFFSET")
    field(PREC, "4")
}
record(ao, "pigcs2:m1Resolution") {
    field(DESC, "m1 resolution")
    field(DOL, "pigcs2:m1.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(C867,0)MOTOR_REC_RESOLUTION")
    field(PREC, "4")
}
record(bo, "pigcs2:m1_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "pigcs2:m1.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "pigcs2:m1_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "pigcs2:m1.TWV")
    field(INPC, "pigcs2:m1.MRES")
    field(INPD, "pigcs2:m1.HLM")
    field(INPE, "pigcs2:m1.LLM")
    field(OUT, "pigcs2:m1.TWV")
}
record(calcout, "pigcs2:m1_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "pigcs2:m1.S")
    field(INPC, "pigcs2:m1.SBAS")
    field(INPD, "pigcs2:m1.SMAX")
    field(OUT, "pigcs2:m1.S")
}
record(motor, "pigcs2:m2") {
    field(ACCL, ".2")
    field(ACCU, "0")
    field(BACC, ".2")
    field(BDST, "0")
    field(BVEL, "1")
    field(DESC, "Motor 2")
    field(DHLM, "0.0")
    field(DIR, "Pos")
    field(DLLM, "0.0")
    field(DTYP, "asynMotor")
    field(EGU, "deg")
    field(INIT, "")
    field(MRES, "0.0020")
    field(OUT, "@asyn(C867,1)")
    field(PREC, "4")
    field(RSTM, "NearZero")
    field(RTRY, "10")
    field(SDIS, "pigcs2:m2_able.VAL")
    field(TWV, "1")
    field(VBAS, "0")
    field(VELO, "5")
}
record(longout, "pigcs2:m2Direction") {
    field(DESC, "m2 direction")
    field(DOL, "pigcs2:m2.DIR CP MS")
    field(DTYP, "asynInt32")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(C867,1)MOTOR_REC_DIRECTION")
}
record(ao, "pigcs2:m2Offset") {
    field(DESC, "m2 offset")
    field(DOL, "pigcs2:m2.OFF CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(C867,1)MOTOR_REC_OFFSET")
    field(PREC, "4")
}
record(ao, "pigcs2:m2Resolution") {
    field(DESC, "m2 resolution")
    field(DOL, "pigcs2:m2.MRES CP MS")
    field(DTYP, "asynFloat64")
    field(OMSL, "closed_loop")
    field(OUT, "@asyn(C867,1)MOTOR_REC_RESOLUTION")
    field(PREC, "4")
}
record(bo, "pigcs2:m2_able") {
    field(DESC, "motor enable")
    field(ONAM, "Disable")
    field(OUT, "pigcs2:m2.DISP")
    field(PINI, "YES")
    field(ZNAM, "Enable")
}
record(calcout, "pigcs2:m2_twCh") {
    field(CALC, "min(max(a*b,c),d-e)")
    field(DESC, "change TWV")
    field(INPB, "pigcs2:m2.TWV")
    field(INPC, "pigcs2:m2.MRES")
    field(INPD, "pigcs2:m2.HLM")
    field(INPE, "pigcs2:m2.LLM")
    field(OUT, "pigcs2:m2.TWV")
}
record(calcout, "pigcs2:m2_vCh") {
    field(CALC, "min(max(a*b,c),d)")
    field(DESC, "change velocity")
    field(INPB, "pigcs2:m2.S")
    field(INPC, "pigcs2:m2.SBAS")
    field(INPD, "pigcs2:m2.SMAX")
    field(OUT, "pigcs2:m2.S")
}
record(longout, "pigcs2:moving") {
    field(DESC, "Motors moving count.")
}
record(waveform, "pigcs2:movingDiff") {
    field(DESC, "Motor w/ last dmov change")
    field(FTVL, "CHAR")
    field(NELM, "62")
}
