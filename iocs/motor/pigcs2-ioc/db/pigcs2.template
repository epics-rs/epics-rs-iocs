# PI GCS2: one motor record per axis. DTYP is PIGCS2_$(CTRL)_$(AXIS), the key
# registered by PIGCS2CreateController (card + GCS axis name string, e.g.
# "1" — not a bare index).
#
# Positions/velocities/accelerations are the controller's native physical
# units (GCS2 POS/MOV/VEL are already EGU on the controller), with no
# resolution scaling in the driver, and EGU is the controller unit (typically
# mm). MRES is the record's step (RRBV is an integer count), so set it to the
# axis resolution; the default is the C example's (PI_GCS2.substitutions).
# VELO/ACCL are in units/second and units/second^2.

record(motor, "$(P)$(M)") {
    field(DTYP, "PIGCS2_$(CTRL)_$(AXIS)")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=25)")
    field(DLLM, "$(LLM=-25)")
    field(MRES, "$(MRES=0.0005)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
