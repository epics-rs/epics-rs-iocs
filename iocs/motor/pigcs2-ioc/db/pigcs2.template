# PI GCS2: one motor record per axis, ADDR the 0-based index of the axis in
# SAI? order on controller port PORT, as in C's basic_asyn_motor.db.
#
# The driver converts the record's steps by the axis counts-per-unit
# (SPA? CPU Z/N) into the controller's units (typically mm), as C; MRES is the
# C example's (PI_GCS2.substitutions).

record(motor, "$(P)$(M)") {
    field(DTYP, "asynMotor")
    field(OUT,  "@asyn($(PORT),$(ADDR))")
    field(SCAN, "Passive")
    field(VELO, "$(VELO=1)")
    field(ACCL, "$(ACCL=0.2)")
    field(DHLM, "$(HLM=25)")
    field(DLLM, "$(LLM=-25)")
    field(MRES, "$(MRES=0.0005)")
    field(EGU,  "$(EGU=mm)")
    field(PREC, "$(PREC=4)")
}
