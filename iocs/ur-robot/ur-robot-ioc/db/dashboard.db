# The read-only half of the dashboard surface, plus Connect/Disconnect —
# link management a monitoring IOC still needs. Everything that drives
# the robot (Play/Stop/PowerOff/...) lives in dashboard_ctrl.db; an IOC
# that loads only this file exposes no way to write those commands.

record(bi, "$(P)Dashboard:Connected")
{
    field(DESC, "Connection status")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))IS_CONNECTED")
    field(VAL, 0)
    field(SCAN, "I/O Intr")
}

record(bi, "$(P)Dashboard:IsProgramSaved")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))IS_PROGRAM_SAVED")
    field(VAL, 0)
    field(SCAN, "I/O Intr")
}

record(bi, "$(P)Dashboard:IsInRemoteControl")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))IS_IN_REMOTE_CONTROL")
    field(VAL, 0)
    field(SCAN, "I/O Intr")
}

record(bi, "$(P)Dashboard:Running")
{
    field(DESC, "Program runnning status")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))IS_RUNNING")
    field(VAL, 0)
    field(SCAN, "I/O Intr")
}

record(bo, "$(P)Dashboard:Connect")
{
    field(DESC, "Connects to dashboard server")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))CONNECT")
    field(VAL, 1)
}

record(bo, "$(P)Dashboard:Disconnect")
{
    field(DESC, "Closes connection")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))DISCONNECT")
    field(VAL, 1)
}

