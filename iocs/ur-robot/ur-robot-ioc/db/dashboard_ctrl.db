# The dashboard control surface, split from dashboard.db so a monitoring
# IOC can load the status half alone: a record that is not loaded cannot
# be written through CA or PVA — surface removal, not permission checks.
# dashboard.db keeps the readbacks plus Connect/Disconnect (link
# management is needed even read-only); this file is everything that
# drives the robot.

record(bo, "$(P)Dashboard:Play")
{
    field(DESC, "Play program")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))PLAY")
    field(VAL, 1)
}

record(bo, "$(P)Dashboard:Stop")
{
    field(DESC, "Stop program")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))STOP")
    field(VAL, 1)
}

record(bo, "$(P)Dashboard:Pause")
{
    field(DESC, "Pause program")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))PAUSE")
    field(VAL, 1)
}

