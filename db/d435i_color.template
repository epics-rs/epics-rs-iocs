# D435i Color port records
# Macros: P, R, PORT, ADDR, TIMEOUT

include "ADBase.template"

# ===== D435i Stream config =====
# No state fields on RSStreamMode: the driver serves the enum through asynEnum,
# built from the modes the attached camera reports for Color(RGB8) and
# Depth(Z16) both. A fixed table offered a D405 modes it rejects.
record(mbbo, "$(P)$(R)RSStreamMode") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))RS_STREAM_MODE")
}

record(mbbi, "$(P)$(R)RSStreamMode_RBV") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))RS_STREAM_MODE")
    field(SCAN, "I/O Intr")
}

