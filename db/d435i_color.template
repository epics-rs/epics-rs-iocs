# ===== Intrinsics (read-only, both sets on the color port) =====
# A pinhole model in pixels: fx/fy focal length, PPx/PPy principal point, plus
# the distortion model and its five coefficients in librealsense's coeffs[]
# order. Read from the stream profile in use, so they follow RSStreamMode --
# a 1280x720 profile does not share a 640x480 profile's principal point.
#
# The depth set is prefixed rather than living on the depth port: the depth
# driver carries only an ADDriverBase and has no parameter set of its own.
#
# Published on the first frame after acquisition starts. Before that they read
# 0 -- intrinsics come from the running pipeline, not from the device.
record(ai, "$(P)$(R)RSFx_RBV") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))RS_FX")
    field(EGU,  "px")
    field(PREC, "4")
    field(SCAN, "I/O Intr")
}

record(ai, "$(P)$(R)RSFy_RBV") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(ADDR),$(TIMEOUT))RS_FY")
    field(EGU,  "px")
    field(PREC, "4")
    field(SCAN, "I/O Intr")
}

